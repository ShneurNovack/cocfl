---
import { programs } from '../data/programs';
import { SITE } from '../lib/site';
import { GUIDES } from '../data/guides';
import Icon from './Icon.astro';
import SocialIcon from './SocialIcon.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <img class="wm" src="/flame.png" alt="" width="96" height="96" loading="lazy" />
  <div class="wrap cols">
    <div class="about">
      <a href="/" class="brand"><img class="mk" src="/flame.png" alt="" width="36" height="36" loading="lazy" /> Chabad on Campus Florida</a>
      <p>A joint initiative of the Chabad on Campus centers across Florida, each one independently run by its own rabbi and rebbetzin.</p>
      <div class="fbtns">
        <a class="btn btn-gold" href="/campuses/"><Icon name="MapPin" size={18} /> Find Chabad at your school</a>
        <a class="btn fsup" href="/support/"><Icon name="Heart" size={18} /> Support your local Chabad</a>
      </div>
      <a class="ig" href={SITE.instagram} rel="noopener" aria-label="Chabad on Campus Florida on Instagram"><SocialIcon type="Instagram" size={20} /> @chabadoncampusfl</a>
    </div>
    <div>
      <nav aria-label="Programs">
        <h2>Programs</h2>
        <ul>{programs.map((p) => <li><a href={`/programs/${p.slug}/`}>{p.name}</a></li>)}</ul>
      </nav>
    </div>
    <nav aria-label="Jewish life guides">
      <h2>Jewish life in college</h2>
      <ul>
        {GUIDES.map((g) => <li><a href={g.href}>{g.nav}</a></li>)}
        <li><a href="/parents/">For parents</a></li>
        <li><a href="/support/">Support a Chabad House</a></li>
        <li><a href="/faq/">Chabad on Campus FAQs</a></li>
        <li><a href="/about/">About Chabad on Campus Florida</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap"><div class="legal">
    <span>&copy; {year} Chabad on Campus Florida</span>
  </div></div>
</footer>

<style>
  .site-footer { background: var(--blue-night); color: #b8cddd; font-size: 0.93rem; padding-top: clamp(64px, 8vw, 96px); position: relative; overflow: hidden; }
  .wm { position: absolute; right: -40px; bottom: -40px; width: 360px; height: auto; opacity: 0.05; pointer-events: none; }
  .mk { width: 36px; height: 36px; }
  .site-footer a { color: #e3eff8; text-decoration: none; }
  .site-footer a:hover { color: var(--gold); text-decoration: underline; }
  .fbtns { display: grid; gap: 10px; justify-items: stretch; max-width: 300px; margin-top: 8px; }
  .fbtns .btn { justify-content: flex-start; padding: 16px 22px; }
  .site-footer .btn-gold { color: var(--ink); }
  .site-footer .fsup { border: 2px solid rgba(255, 255, 255, 0.5); color: #fff; background: transparent; }
  .site-footer .fsup:hover { border-color: var(--gold); color: var(--gold); text-decoration: none; }
  .ig { display: inline-flex; align-items: center; gap: 10px; margin-top: 22px; font-weight: 700; }
  .site-footer .btn-gold:hover { background: #fff; color: var(--blue-ink); text-decoration: none; }
  .site-footer .btn-gold:hover :global(.icon) { transform: none; }
  .cols { display: grid; gap: 40px; grid-template-columns: 1.4fr 1fr 1fr; }
  @media (max-width: 1000px) { .cols { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .cols { grid-template-columns: minmax(0, 1fr); } }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: #fff; font-weight: 800; font-size: 1.05rem; margin-bottom: 14px; }
  h2 { color: #fff; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 14px; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .about p { line-height: 1.7; max-width: 38ch; }
  .legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; margin-top: 48px; padding-top: 22px; padding-bottom: 28px; border-top: 1px solid rgba(255, 255, 255, 0.1); font-size: 0.84rem; color: #8fb0c7; }
  .legal a { color: #b8cddd; text-decoration: underline; }
</style>
