---
import type { Center } from '../lib/centers';
import CenterLogo from './CenterLogo.astro';
import Icon from './Icon.astro';
import { stateAbbr } from '../lib/centers';
interface Props { center: Center; headingLevel?: 'h2' | 'h3'; compact?: boolean }
const { center: c, headingLevel = 'h3', compact = false } = Astro.props;
const H = headingLevel;
const also = c.otherCampuses;
const bg = c.image ? c.image.src.replace('-w1280', '-w640') : null;
---
<article class:list={['ccard', compact && 'compact']} data-center={c.id} data-search={c.searchText} data-primary={`${c.primaryCampus.name}|${c.primaryCampus.abbr || ''}`}>
  <div class:list={['cover', !bg && 'nobg']}>
    {bg ? <img src={bg} alt="" loading="lazy" decoding="async" /> : <img class="fl" src="/flame.webp" alt="" loading="lazy" width="96" height="96" />}
  </div>
  <div class="logo"><CenterLogo center={c} size={68} /></div>
  <div class="body">
    <H class="school"><a href={c.url} class="stretch">{c.primaryCampus.name}</a></H>
    <p class="meta"><Icon name="MapPin" size={16} /> {c.city}, {stateAbbr(c.address?.state ?? null)}</p>
    {also.length > 0 && <p class="also">Also welcoming {also.map((o) => o.abbr || o.name).join(', ')}</p>}
    <span class="go">{c.officialName} <Icon name="ArrowRight" size={20} /></span>
  </div>
</article>

<style>
  .ccard { position: relative; background: #fff; border: 2px solid var(--line); display: flex; flex-direction: column; height: 100%; transition: border-color 0.2s; }
  .ccard:hover { border-color: var(--blue); }
  .cover { height: 150px; position: relative; overflow: hidden; background: var(--blue-night); }
  .cover img { width: 100%; height: 100%; object-fit: cover; opacity: 0.75; transition: transform 0.7s var(--ease), opacity 0.3s; }
  .ccard:hover .cover img { transform: scale(1.06); opacity: 0.9; }
  .cover.nobg { background: var(--blue); }
  .cover.nobg .fl { position: absolute; right: 18px; top: 50%; translate: 0 -50%; width: 110px; height: auto; opacity: 0.35; object-fit: contain; }
  .logo { position: relative; z-index: 2; margin: -36px 0 0 22px; width: max-content; background: #fff; border: 3px solid #fff; }
  .body { padding: 18px 24px 24px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .school { font-size: 1.25rem; line-height: 1.2; margin: 0; }
  .school a { color: var(--ink); text-decoration: none; }
  .stretch::after { content: ''; position: absolute; inset: 0; z-index: 3; }
  .ccard:hover .school a { color: var(--blue); }
  .meta { display: flex; align-items: center; gap: 6px; margin: 0; font-size: 0.95rem; color: var(--muted); }
  .meta :global(.icon) { color: var(--gold-deep); }
  .also { margin: 0; font-size: 0.92rem; color: var(--ink-2); }
  .go { margin-top: auto; padding-top: 16px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; gap: 10px; font-weight: 750; font-size: 0.95rem; color: var(--blue); }
  .go :global(.icon) { flex-shrink: 0; transition: transform 0.2s var(--ease); }
  .ccard:hover .go :global(.icon) { transform: translateX(5px); }
  .compact .cover { height: 110px; }
</style>
