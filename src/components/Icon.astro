---
// Inline Lucide icons (stroke icons, inherit currentColor). Usage: <Icon name="MapPin" size={20} />
import * as icons from 'lucide-static';
interface Props { name: keyof typeof icons | string; size?: number; class?: string; label?: string; stroke?: number }
const { name, size = 22, label, stroke = 2 } = Astro.props;
if (!(icons as Record<string, string>)[name]) console.warn(`[Icon] unknown icon: ${name}`);
let svg = ((icons as Record<string, string>)[name] || (icons as Record<string, string>).Circle) as string;
svg = svg
  .replace(/\s*class="[^"]*"/, '')
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace(/stroke-width="2"/, `stroke-width="${stroke}"`)
  .replace('<svg', `<svg class="icon ${Astro.props.class || ''}" ${label ? `role="img" aria-label="${label}"` : 'aria-hidden="true" focusable="false"'}`)
  .replace(/\n\s*/g, ' ');
---
<Fragment set:html={svg} />
