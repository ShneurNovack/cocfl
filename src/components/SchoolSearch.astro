---
// "Is there a Chabad at my school?" typeahead. Suggests every college we serve
// (including secondary campuses) and jumps straight to that center's page.
// Without JS it submits to /campuses/?q= which filters the directory.
import { allColleges } from '../lib/centers';
import Icon from './Icon.astro';
interface Props { id?: string; placeholder?: string; label?: string; size?: 'lg' | 'md'; showLabel?: boolean }
const { id = 'school-search', placeholder = 'Type your school: UF, FIU, Rollins...', label = 'Is there a Chabad at my school?', size = 'lg', showLabel = true } = Astro.props;
const items = allColleges().map((r) => ({
  n: r.campus.name,
  a: r.campus.abbr || '',
  c: r.center.officialName,
  city: r.center.city,
  u: r.campus.primary ? r.center.url : `${r.center.url}#${r.campus.anchor}`,
  k: [r.campus.name, r.campus.abbr, r.center.officialName, r.center.shortName, r.center.city, ...r.center.aliases].join(' '),
  logo: r.center.logo?.src || '',
}));
---
<form class:list={['ss', `ss-${size}`]} action="/campuses/" method="get" role="search" data-ss={id}>
  <label for={id} class:list={[!showLabel && 'visually-hidden']}>{label}</label>
  <div class="ss-field">
    <Icon name="Search" size={22} class="ss-icon" />
    <input id={id} name="q" type="search" placeholder={placeholder} autocomplete="off" spellcheck="false" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls={`${id}-list`} />
    <button class="btn btn-gold" type="submit">Find my Chabad</button>
  </div>
  <ul class="ss-list" id={`${id}-list`} role="listbox" hidden></ul>
  <script type="application/json" data-ss-items set:html={JSON.stringify(items)} />
</form>

<script>
  type Item = { n: string; a: string; c: string; city: string; u: string; k: string; logo: string };
  const STOP = new Set(['the', 'of', 'at', 'chabad', 'in', 'a', 'and', 'on', 'campus']);
  const norm = (s: string) => s.toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '').replace(/&/g, ' and ').replace(/[@'’.]/g, '').replace(/[^a-z0-9]+/g, ' ').trim();
  const lev = (a: string, b: string) => {
    const m = Array.from({ length: a.length + 1 }, (_, i) => [i, ...Array(b.length).fill(0)]);
    for (let j = 1; j <= b.length; j++) m[0][j] = j;
    for (let i = 1; i <= a.length; i++) for (let j = 1; j <= b.length; j++) m[i][j] = Math.min(m[i - 1][j] + 1, m[i][j - 1] + 1, m[i - 1][j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));
    return m[a.length][b.length];
  };
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  document.querySelectorAll<HTMLFormElement>('form[data-ss]').forEach((form) => {
    const input = form.querySelector('input')!;
    const list = form.querySelector('ul')!;
    const items: Item[] = JSON.parse(form.querySelector('[data-ss-items]')!.textContent!);
    const idx = items.map((it) => ({ it, words: norm(it.k).split(' '), name: norm(it.n), abbr: norm(it.a) }));
    let active = -1;
    let results: Item[] = [];

    const score = (q: string, tokens: string[], x: (typeof idx)[number]) => {
      let s = 0;
      for (const t of tokens) {
        let best = 0;
        for (const w of x.words) {
          if (w === t) best = Math.max(best, 3);
          else if (w.startsWith(t)) best = Math.max(best, 2);
          else if (t.length >= 4 && lev(t, w.slice(0, t.length + 1)) <= (t.length >= 7 ? 2 : 1)) best = Math.max(best, 1);
        }
        if (!best) return 0;
        s += best;
      }
      if (x.abbr && x.abbr === q) s += 20;
      if (x.name.startsWith(q)) s += 12;
      else if (x.name.includes(q)) s += 6;
      return s;
    };

    const render = () => {
      const q = norm(input.value);
      const tokens = q.split(' ').filter((t) => t && !STOP.has(t));
      if (!tokens.length) { list.hidden = true; input.setAttribute('aria-expanded', 'false'); return; }
      results = idx.map((x) => ({ x, s: score(q, tokens, x) })).filter((r) => r.s > 0).sort((a, b) => b.s - a.s).slice(0, 6).map((r) => r.x.it);
      active = results.length ? 0 : -1;
      list.innerHTML = results.length
        ? results.map((r, i) => `<li role="option" id="${form.dataset.ss}-o${i}" aria-selected="${i === active}"><a href="${r.u}">${r.logo ? `<img src="${r.logo}" alt="" width="36" height="36">` : '<span class="ph"></span>'}<span><strong>${esc(r.n)}${r.a ? ` <em>${esc(r.a)}</em>` : ''}</strong><small>${esc(r.c)} · ${esc(r.city)}</small></span></a></li>`).join('')
        : `<li class="none">No Florida campus matches yet. <a href="/campuses/">Browse every campus</a></li>`;
      list.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      input.setAttribute('aria-activedescendant', active >= 0 ? `${form.dataset.ss}-o0` : '');
    };
    const move = (d: number) => {
      if (!results.length) return;
      active = (active + d + results.length) % results.length;
      list.querySelectorAll('li').forEach((li, i) => li.setAttribute('aria-selected', String(i === active)));
      input.setAttribute('aria-activedescendant', `${form.dataset.ss}-o${active}`);
    };
    input.addEventListener('input', render);
    input.addEventListener('focus', () => input.value && render());
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
      else if (e.key === 'Escape') { list.hidden = true; }
    });
    form.addEventListener('submit', (e) => {
      if (active >= 0 && results[active] && !list.hidden) { e.preventDefault(); location.href = results[active].u; }
    });
    document.addEventListener('click', (e) => { if (!form.contains(e.target as Node)) list.hidden = true; });
  });
</script>

<style>
  .ss { position: relative; width: 100%; max-width: 680px; text-align: left; container-type: inline-size; }
  .ss label { display: block; font-weight: 750; margin-bottom: 12px; font-size: 1.05rem; }
  .ss-field { display: flex; align-items: stretch; background: #fff; border: 2px solid var(--ink); }
  .ss-field:focus-within { border-color: var(--gold); outline: 2px solid var(--gold); }
  .ss-field :global(.ss-icon) { color: var(--muted); flex-shrink: 0; align-self: center; margin-left: 18px; }
  .ss-field input { flex: 1; min-width: 0; border: 0; font: 550 1.1rem var(--font); padding: 18px 14px; color: var(--ink); background: transparent; }
  .ss-field input:focus { outline: none; }
  .ss-field .btn { border: 0; padding: 0 26px; }
  .ss-md .ss-field input { padding: 15px 12px; font-size: 1.02rem; }
  @container (max-width: 440px) { .ss-field .btn { padding: 0 18px; font-size: 0; gap: 0; } .ss-field .btn::after { content: 'Go'; font-size: 1rem; } }
  .ss-list { position: absolute; z-index: 30; left: 0; right: 0; top: calc(100% - 2px); list-style: none; margin: 0; padding: 0; background: #fff; border: 2px solid var(--ink); max-height: 440px; overflow: auto; }
  .ss-list :global(li + li) { border-top: 1px solid var(--line); }
  .ss-list :global(li a) { display: flex; gap: 14px; align-items: center; padding: 14px 16px; text-decoration: none; color: var(--ink); }
  .ss-list :global(li[aria-selected='true'] a), .ss-list :global(li a:hover) { background: var(--gold-wash); }
  .ss-list :global(img), .ss-list :global(.ph) { width: 40px; height: 40px; object-fit: contain; background: #fff; border: 1px solid var(--line); flex-shrink: 0; }
  .ss-list :global(.ph) { background: var(--blue); border: 0; }
  .ss-list :global(strong) { display: block; font-size: 1rem; line-height: 1.25; }
  .ss-list :global(em) { font-style: normal; color: var(--blue); font-weight: 700; }
  .ss-list :global(small) { display: block; color: var(--muted); font-size: 0.86rem; }
  .ss-list :global(.none) { padding: 16px; color: var(--ink-2); font-size: 0.95rem; }
</style>
