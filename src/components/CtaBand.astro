---
interface Props { title?: string; text?: string; primary?: { href: string; label: string }; secondary?: { href: string; label: string } }
const {
  title = 'Is there a Chabad at your school?',
  text = 'Search every Chabad on Campus center in Florida by university, abbreviation, city or rabbi.',
  primary = { href: '/campuses/', label: 'Find your campus' },
  secondary,
} = Astro.props;
---
<section class="cta band-blue">
  <div class="wrap inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn-gold" href={primary.href}>{primary.label}</a>
      {secondary && <a class="btn btn-ghost" href={secondary.href}>{secondary.label}</a>}
    </div>
  </div>
</section>
<style>
  .cta { padding: clamp(40px, 6vw, 64px) 0; }
  .inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; }
  h2 { margin-bottom: 6px; }
  p { margin: 0; color: #eaf3fa; max-width: 56ch; }
</style>
