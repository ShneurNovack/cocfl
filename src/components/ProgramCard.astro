---
import type { Program } from '../data/programs';
import { img } from '../lib/site';
import Icon from './Icon.astro';
interface Props { program: Program; headingLevel?: 'h2' | 'h3' }
const { program: p, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const i = img(p.image);
const catIcon: Record<string, string> = { Learning: 'BookOpen', Shabbatons: 'Flame', 'Travel & Israel': 'Plane', 'Care & Home': 'HeartHandshake' };
---
<article class="pcard" data-cat={p.category}>
  <div class="thumb">
    <img src={`/images/${p.image}-640.webp`} width={640} height={Math.round((640 * i.height) / i.width)} alt="" loading="lazy" decoding="async" />
    <span class="cat"><Icon name={catIcon[p.category]} size={16} /> {p.category}</span>
  </div>
  <div class="body">
    <H><a href={`/programs/${p.slug}/`} class="stretch">{p.name}</a></H>
    <p>{p.tagline}</p>
    <span class="go">Learn about {p.shortName} <Icon name="ArrowRight" size={20} /></span>
  </div>
</article>
<style>
  .pcard { position: relative; background: #fff; height: 100%; display: flex; flex-direction: column; border: 2px solid var(--line); transition: border-color 0.2s; }
  .pcard:hover { border-color: var(--blue); }
  .thumb { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--cream); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s var(--ease); }
  .pcard:hover .thumb img { transform: scale(1.06); }
  .cat { position: absolute; left: 0; bottom: 0; display: inline-flex; align-items: center; gap: 6px; background: #fff; color: var(--blue-ink); font-size: 0.8rem; font-weight: 750; padding: 8px 14px; }
  [data-cat='Shabbatons'] .cat { background: var(--gold); color: var(--ink); }
  [data-cat='Travel & Israel'] .cat { background: var(--blue); color: #fff; }
  [data-cat='Care & Home'] .cat { background: var(--blue-night); color: #fff; }
  .body { padding: 24px 24px 26px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .body h2, .body h3 { font-size: 1.3rem; margin: 0; }
  .body a { color: var(--ink); text-decoration: none; }
  .pcard:hover .body a { color: var(--blue); }
  .body p { margin: 0; color: var(--ink-2); font-size: 1rem; }
  .stretch::after { content: ''; position: absolute; inset: 0; }
  .go { margin-top: auto; padding-top: 14px; display: inline-flex; align-items: center; gap: 8px; font-weight: 750; font-size: 0.95rem; color: var(--blue); }
  .go :global(.icon) { transition: transform 0.2s var(--ease); }
  .pcard:hover .go :global(.icon) { transform: translateX(5px); }
</style>
