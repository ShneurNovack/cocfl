---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Picture from '../components/Picture.astro';
import CtaBand from '../components/CtaBand.astro';
import { stats, centersByRegion } from '../lib/centers';
import { SITE, TESTIMONIALS } from '../lib/site';
const regions = centersByRegion();
const crumbs = [{ name: 'About', href: '/about/' }];
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'About Chabad on Campus Florida',
    url: `${SITE.url}/about/`,
    about: { '@id': `${SITE.url}/#organization` },
  },
];
---
<Base
  title="About Chabad on Campus Florida"
  description="Chabad on Campus Florida is a statewide network of Chabad Houses serving Jewish students at 25+ Florida colleges. What Chabad on Campus is, our mission and history."
  path="/about/"
  breadcrumbs={crumbs}
  jsonLd={ld}
>
  <section class="page-hero band-blue">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <h1>About Chabad on Campus Florida</h1>
      <p class="lead">A regional initiative of Chabad on Campus centers in the state of Florida, bringing {stats.centers} Chabad Houses and the students they serve together as one statewide community.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="prose">
        <h2>What is Chabad on Campus?</h2>
        <p>Chabad on Campus is a network of Chabad Houses on and near more than 950 college campuses around the world, where Jewish students of every background and affiliation can find a home away from home. Each Chabad House is directed by a husband and wife, known as <em>shluchim</em>, emissaries of the Lubavitcher Rebbe, Rabbi Menachem M. Schneerson. They move to a college town, open their home to students, and build Jewish life around them: Shabbat dinners, holidays, classes, trips and a lot of personal attention.</p>
        <p>There are no dues and no membership. Research on Chabad on Campus has found that almost 90 percent of participants do not come from Orthodox homes. No judgment, just joy.</p>
      </div>
      <Picture name="rabbi-students" alt="A Chabad rabbi learning with college students around a table" aspect="4/3" />
    </div>
  </section>

  <section class="section band-cream">
    <div class="wrap grid grid-3 mvv">
      <div>
        <span class="eyebrow">Our vision</span>
        <h2>Robust Jewish life on every Florida campus</h2>
        <p>We champion robust Jewish life and learning on college campuses in Florida. We seek a future where every Jewish student has a deeper affinity, connection and understanding of their faith, heritage and identity.</p>
      </div>
      <div>
        <span class="eyebrow">What we do</span>
        <h2>Stronger together</h2>
        <p>Chabad on Campus Florida brings the state's Chabad Houses together to share resources, run statewide programs like the Florida Regional Pegisha, and make it easy for every Jewish student and parent to find Jewish life at their school.</p>
      </div>
      <div>
        <span class="eyebrow">By the numbers</span>
        <h2>{stats.centers} centers, {stats.campuses} campuses</h2>
        <p>Serving over {SITE.reported.students} Jewish students, with {SITE.reported.studentsServed} students served and {SITE.reported.engagements} Jewish engagements in {SITE.reported.engagementsYear}.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <Picture name="the-rebbe" alt="The Lubavitcher Rebbe, Rabbi Menachem M. Schneerson" aspect="1/1" class="rebbe" />
      <div class="prose">
        <h2>A short history</h2>
        <p>At the beginning of his leadership in the early 1950s, the Lubavitcher Rebbe, Rabbi Menachem M. Schneerson, reached out to college campuses, sending rabbinical students to serve as a resource for Jewish students. In 1969, Chabad opened its first campus center at the University of California, Los Angeles. Today there are Chabad Houses serving students on more than 950 campuses worldwide.</p>
        <p>Florida has grown into one of the most vibrant regions in the Chabad on Campus network, with centers from Tallahassee and Gainesville to Miami. Rabbi Berl Goldman of Chabad at the University of Florida also serves on the board of Chabad on Campus International.</p>
        <p>Chabad on Campus Florida is part of <a href={SITE.parent.url} rel="noopener">Chabad on Campus International</a>, which supports Chabad Houses worldwide with leadership, programs and resources.</p>
      </div>
    </div>
  </section>

  <section class="section band-cream">
    <div class="wrap">
      <h2>Our centers across Florida</h2>
      <div class="grid grid-4">
        {regions.map((r) => (
          <div>
            <h3>{r.name}</h3>
            <ul class="link-list">{r.centers.map((c) => <li><a href={c.url}>{c.officialName}<span class="meta">{c.primaryCampus.abbr || c.city}</span></a></li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow">
      <h2>From our students</h2>
      {TESTIMONIALS.map((t) => (
        <figure class="q">
          <blockquote>&ldquo;{t.quote}&rdquo;</blockquote>
          <figcaption>{t.name}, {t.school}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .mvv h2 { font-size: 1.4rem; }
  .mvv p { color: var(--ink-2); }
  :global(.rebbe) { max-width: 420px; }
  .q { margin: 0 0 28px; padding-left: 20px; border-left: 3px solid var(--gold); }
  .q blockquote { margin: 0 0 8px; font-size: 1.12rem; color: var(--ink-2); }
  .q figcaption { font-weight: 700; }
</style>
