---
// Florida Pegisha: statewide Shabbaton. Uses the site's fonts and section rhythm,
// with Pegisha's own plum, gold and coral colors (from chabadoncampus.org/pegisha).
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SchoolSearch from '../../components/SchoolSearch.astro';
import CenterLogo from '../../components/CenterLogo.astro';
import Faq from '../../components/Faq.astro';
import Icon from '../../components/Icon.astro';
import { programBySlug } from '../../data/programs';
import { centers } from '../../lib/centers';
import { SITE, img } from '../../lib/site';

const p = programBySlug['florida-pegisha'];
const path = '/programs/florida-pegisha/';
const crumbs = [
  { name: 'Programs', href: '/programs/' },
  { name: 'Florida Pegisha', href: path },
];
const hero = img('fp-havdalah-crowd');
const closerImg = img('fp-havdalah-candle');

const features = [
  { icon: 'Flame', title: 'A Shabbat like no other', text: 'Let us come together with song, dance and delicious kosher food as we welcome Shabbat into our lives.' },
  { icon: 'Sparkles', title: 'Good vibes, positive energy', text: 'Are JEW ready for a weekend packed with new friends from Tallahassee to Miami and Jewish energy that will fire up your soul?' },
  { icon: 'Users', title: 'The whole state in one room', text: 'Every campus, one weekend. Meet the students who make Jewish life happen all across Florida.' },
];

const expect = [
  { title: 'Eat and shmooze', key: 'fp-group' },
  { title: 'Learn and grow', key: 'fp-rebbetzin' },
  { title: 'Hands-on workshops', key: 'fp-workshop' },
  { title: 'Mega Havdalah', key: 'fp-havdalah-candle' },
  { title: 'Sing and dance', key: 'florida-pegisha-students' },
  { title: 'Pegisha swag', key: 'fp-shirts' },
].map((e) => ({ ...e, ...img(e.key) }));

const days = [
  {
    id: 'friday',
    label: 'Friday',
    items: [
      { t: 'Arrival and check-in', s: 'Grab your welcome bag and find your people' },
      { t: 'Pegisha kickoff: snacks and shmooze', s: 'Meet students from every campus' },
      { t: 'Shabbat candle lighting' },
      { t: 'Lively Kabbalat Shabbat services' },
      { t: 'Shabbat dinner', s: 'The whole state around one table' },
      { t: 'Farbrengen and late-night hangouts' },
    ],
  },
  {
    id: 'shabbat',
    label: 'Shabbat',
    items: [
      { t: 'Lively Shabbat morning services' },
      { t: 'Kiddush and Shabbat lunch' },
      { t: 'Engaging workshops and sessions' },
      { t: 'Social time', s: 'Hang out, relax and make new friends' },
      { t: 'Seudah shlishit', s: 'The third Shabbat meal, with song' },
    ],
  },
  {
    id: 'motzei',
    label: 'Saturday night',
    items: [
      { t: 'Florida Pegisha shirts', s: "Suit up in this year's shirt" },
      { t: 'Mega Havdalah', s: 'Hundreds of voices saying goodbye to Shabbat' },
      { t: 'Live music and dancing' },
      { t: 'The Pegisha vibe', s: 'A Motzei Shabbat celebration to close out the weekend' },
    ],
  },
];

const gallery = [
  { key: 'fp-havdalah-crowd', alt: 'Students and families singing at Havdalah', cls: 'big' },
  { key: 'fp-workshop', alt: 'A student taking part in a hands-on workshop', cls: '' },
  { key: 'fp-shirts', alt: 'A stack of Florida Pegisha shirts', cls: '' },
  { key: 'fp-rebbetzin', alt: 'A rebbetzin leading a workshop for students', cls: '' },
  { key: 'fp-group', alt: 'Students in Florida Pegisha shirts', cls: '' },
].map((g) => ({ ...g, ...img(g.key) }));

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: p.metaTitle,
    url: `${SITE.url}${path}`,
    description: p.metaDescription,
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: { '@type': 'Thing', name: 'Florida Pegisha Shabbaton' },
    primaryImageOfPage: { '@type': 'ImageObject', url: `${SITE.url}${hero.src}` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: p.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })),
  },
];
---
<Base title={p.metaTitle} description={p.metaDescription} path={path} breadcrumbs={crumbs} jsonLd={ld} ogImage={img('fp-group').src}>
  <div class="pg">
    <section class="hero">
      <img class="bg" src={hero.src} srcset={hero.srcset} sizes="100vw" width={hero.width} height={hero.height} alt="" fetchpriority="high" decoding="async" />
      <div class="wrap hin">
        <Breadcrumbs items={crumbs} />
        <h1><img class="logo" src="/images/pegisha-statewide.webp" alt="Florida Pegisha" width="720" height="588" /></h1>
        <p class="when">Date TBA / Florida</p>
        <a class="btn pbtn-line" href="#details">Registration opens soon</a>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <p class="intro reveal">Experience an unforgettable Shabbat weekend with Jewish students from every campus across Florida.</p>
        <div class="feats">
          {features.map((f, i) => (
            <div class="feat reveal" style={`--d:${i * 100}ms`}>
              <span class="fic"><Icon name={f.icon} size={30} /></span>
              <h2>{f.title}</h2>
              <p>{f.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section band-soft">
      <div class="wrap">
        <div class="sec-head reveal">
          <h2>What to expect</h2>
          <p class="lead">Get ready for a weekend you will be talking about all semester.</p>
        </div>
        <div class="xgrid">
          {expect.map((e, i) => (
            <figure class="xt reveal" style={`--d:${(i % 3) * 80}ms`}>
              <img src={`/images/${e.key}-640.webp`} srcset={e.srcset} sizes="(max-width: 700px) 100vw, 33vw" width={e.width} height={e.height} alt="" loading="lazy" decoding="async" />
              <figcaption>{e.title}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <div class="goldband"><div class="wrap"><p>One state. One Shabbat. One unforgettable weekend.</p></div></div>

    <section class="section" id="schedule">
      <div class="wrap">
        <div class="sec-head reveal">
          <h2>Sample itinerary</h2>
          <p class="lead">Celebrate, discover, learn and dance.</p>
        </div>
        <div class="dtabs" role="tablist" aria-label="Weekend schedule">
          {days.map((d, i) => <button role="tab" id={`t-${d.id}`} aria-controls={`p-${d.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{d.label}</button>)}
        </div>
        {days.map((d, i) => (
          <ol class="tl" role="tabpanel" id={`p-${d.id}`} aria-labelledby={`t-${d.id}`} hidden={i !== 0}>
            {d.items.map((it, n) => (
              <li>
                <span class="num">{String(n + 1).padStart(2, '0')}</span>
                <span class="tt"><strong>{it.t}</strong>{it.s && <small>{it.s}</small>}</span>
              </li>
            ))}
          </ol>
        ))}
        <p class="note">This is a general schedule. Times and details may vary from year to year.</p>
      </div>
    </section>

    <section class="section band-soft" id="details">
      <div class="wrap">
        <div class="card-d reveal">
          <div class="cd-left">
            <h2>Florida Pegisha</h2>
            <p>Florida Pegisha is more than an event. It is a weekend where Jewish students from every corner of the state come together, celebrate Shabbat in a big way and walk away with friends for life. Your unforgettable weekend awaits!</p>
            <p class="closed"><Icon name="Clock" size={20} /> Registration for this year's Florida Pegisha is not open yet.</p>
          </div>
          <dl class="cd-right">
            <div><dt>Weekend of</dt><dd>Friday to Saturday night</dd><dd class="tba">Date TBA</dd></div>
            <div><dt>Location</dt><dd>Florida</dd><dd class="tba">Location TBA</dd></div>
            <div class="stay"><dt>Stay in the loop</dt><dd>Your campus Chabad House will share registration details as soon as they are ready.</dd>
              <dd class="ss-wrap"><SchoolSearch id="fp-search" size="md" label="Find your Chabad House" showLabel={false} /></dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="sec-head reveal">
          <h2>#FloridaPegisha memories</h2>
        </div>
        <div class="gal">
          {gallery.map((g) => (
            <button type="button" class:list={['shot', g.cls]} data-full={g.src} data-alt={g.alt} aria-label={`View photo: ${g.alt}`}>
              <img src={`/images/${g.key}-640.webp`} srcset={g.srcset} sizes="(max-width: 700px) 100vw, 50vw" width={g.width} height={g.height} alt={g.alt} loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
      </div>
      <dialog class="lb" aria-label="Photo">
        <button type="button" class="lb-x" aria-label="Close"><Icon name="X" size={28} /></button>
        <img alt="" />
      </dialog>
    </section>

    <section class="section band-soft">
      <div class="wrap">
        <div class="sec-head reveal">
          <h2>Every Florida campus is invited</h2>
          <p class="lead">Students come with their own Chabad House. Find yours.</p>
        </div>
        <ul class="logos">
          {centers.map((c) => (
            <li><a href={c.url}><CenterLogo center={c} size={56} /><span>{c.primaryCampus.name}</span></a></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section">
      <div class="wrap narrow">
        <div class="sec-head reveal">
          <h2>Frequently asked questions</h2>
        </div>
        <Faq items={p.faqs} open />
      </div>
    </section>

    <section class="closer">
      <img class="bg" src={closerImg.src} srcset={closerImg.srcset} sizes="100vw" width={closerImg.width} height={closerImg.height} alt="" loading="lazy" />
      <div class="wrap cin">
        <img class="logo-sm" src="/images/pegisha-statewide.webp" alt="" width="720" height="588" loading="lazy" />
        <p>Registration opens soon. Stay tuned!</p>
        <a class="btn pbtn-gold" href="/campuses/">Find your Chabad House <Icon name="ArrowRight" size={20} /></a>
      </div>
    </section>
  </div>
</Base>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.dtabs [role=tab]'));
  const select = (t: HTMLButtonElement) => {
    tabs.forEach((x) => {
      const on = x === t;
      x.setAttribute('aria-selected', String(on));
      x.tabIndex = on ? 0 : -1;
      document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
    });
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (d) { const n = tabs[(i + d + tabs.length) % tabs.length]; select(n); n.focus(); }
    });
  });

  const lb = document.querySelector<HTMLDialogElement>('.lb')!;
  const lbImg = lb.querySelector('img')!;
  document.querySelectorAll<HTMLButtonElement>('.shot').forEach((b) =>
    b.addEventListener('click', () => { lbImg.src = b.dataset.full!; lbImg.alt = b.dataset.alt!; lb.showModal(); }),
  );
  lb.querySelector('.lb-x')!.addEventListener('click', () => lb.close());
  lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
</script>

<style>
  .pg {
    --plum: #330b2f;
    --pgold: #ffc600;
    --coral: #ff6b6b;
    --soft: #f6f3f6;
  }
  .pg h2 { color: var(--plum); }
  .band-soft { background: var(--soft); }
  .btn.pbtn-line { border: 2px solid var(--pgold); color: var(--pgold); background: transparent; }
  .btn.pbtn-line:hover { background: var(--pgold); color: var(--plum); }
  .btn.pbtn-gold { background: var(--pgold); color: var(--plum); }
  .btn.pbtn-gold:hover { background: #fff; }

  /* hero: full-bleed photo, flat plum overlay, logo centered */
  .hero { position: relative; min-height: clamp(560px, 86vh, 820px); display: flex; align-items: center; background: var(--plum); text-align: center; }
  .hero .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero::after { content: ''; position: absolute; inset: 0; background: rgba(51, 11, 47, 0.78); }
  .hin { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; padding-block: clamp(64px, 9vw, 120px); }
  .hin :global(.crumbs) { justify-content: center; margin-bottom: clamp(24px, 4vw, 48px); }
  .hin :global(.crumbs), .hin :global(.crumbs a) { color: #e9d3e6; }
  .hero h1 { margin: 0 0 28px; line-height: 0; }
  .logo { width: min(78vw, 460px); height: auto; }
  .when { color: var(--pgold); font-weight: 800; font-size: 1rem; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 32px; }

  /* intro + features */
  .intro { font-size: clamp(1.35rem, 2.4vw, 2rem); font-weight: 700; line-height: 1.35; color: var(--plum); text-align: center; max-width: 30ch; margin: 0 auto clamp(56px, 7vw, 88px); }
  .feats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(32px, 5vw, 72px); }
  @media (max-width: 860px) { .feats { grid-template-columns: minmax(0, 1fr); } }
  .feat { text-align: center; }
  .fic { display: inline-grid; place-items: center; width: 72px; height: 72px; background: var(--plum); color: var(--pgold); margin-bottom: 22px; }
  .feat h2 { font-size: 1.45rem; margin: 0 0 10px; }
  .feat p { margin: 0 auto; color: var(--ink-2); max-width: 34ch; }

  /* what to expect */
  .xgrid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 860px) { .xgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .xgrid { grid-template-columns: minmax(0, 1fr); } }
  .xt { position: relative; margin: 0; aspect-ratio: 4 / 3; overflow: hidden; background: var(--plum); }
  .xt img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s var(--ease); }
  .xt::after { content: ''; position: absolute; inset: 0; background: rgba(51, 11, 47, 0.45); transition: background 0.3s; }
  .xt:hover img { transform: scale(1.05); }
  .xt:hover::after { background: rgba(51, 11, 47, 0.25); }
  .xt figcaption { position: absolute; inset: 0; z-index: 1; display: grid; place-items: center; color: #fff; font-weight: 800; font-size: clamp(1.1rem, 1.8vw, 1.4rem); text-transform: uppercase; letter-spacing: 0.04em; text-align: center; padding: 16px; }

  .goldband { background: var(--pgold); padding: clamp(40px, 5vw, 64px) 0; text-align: center; }
  .goldband p { margin: 0; font-size: clamp(1.4rem, 3vw, 2.2rem); font-weight: 800; color: var(--plum); line-height: 1.2; }

  /* itinerary */
  .dtabs { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: clamp(32px, 4vw, 48px); }
  .dtabs button { font: 800 1rem var(--font); text-transform: uppercase; letter-spacing: 0.05em; padding: 14px 26px; border: 2px solid var(--plum); background: #fff; color: var(--plum); cursor: pointer; transition: background 0.2s, color 0.2s, border-color 0.2s; }
  .dtabs button:hover { background: var(--soft); }
  .dtabs button[aria-selected='true'] { background: var(--coral); border-color: var(--coral); color: #fff; }
  .tl { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 12px; }
  .tl[hidden] { display: none; }
  .tl li { display: flex; flex-direction: column; gap: 18px; padding: 26px 24px 28px; background: #fff; border: 2px solid #eadfe8; border-top: 6px solid var(--plum); transition: border-color 0.2s; }
  .tl li:hover { border-color: var(--coral); }
  .num { font-size: 2.4rem; font-weight: 850; line-height: 1; color: var(--coral); }
  .tt strong { display: block; font-size: 1.2rem; line-height: 1.3; color: var(--plum); }
  .tt small { display: block; margin-top: 6px; color: var(--muted); font-size: 0.95rem; line-height: 1.5; }
  .note { margin: 24px 0 0; font-size: 0.93rem; color: var(--muted); font-style: italic; }

  /* details card */
  .card-d { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); background: #fff; border: 2px solid #eadfe8; }
  @media (max-width: 900px) { .card-d { grid-template-columns: minmax(0, 1fr); } }
  .cd-left { padding: clamp(32px, 5vw, 64px); }
  .pg .cd-left h2 { color: var(--coral); margin-bottom: 20px; }
  .cd-left p { color: var(--ink-2); }
  .cd-left p.closed { display: flex; gap: 10px; align-items: flex-start; margin-top: 28px; padding: 18px 20px; background: var(--soft); color: var(--plum); font-weight: 750; border-left: 4px solid var(--coral); }
  .closed :global(.icon) { flex-shrink: 0; margin-top: 3px; color: var(--coral); }
  .cd-right { margin: 0; padding: clamp(32px, 5vw, 64px); background: var(--plum); color: #fff; display: grid; gap: 30px; align-content: start; }
  .cd-right dt { font-size: 0.85rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--coral); margin-bottom: 6px; }
  .cd-right dd { margin: 0; font-size: 1.35rem; font-weight: 800; color: #fff; }
  .cd-right dd.tba { font-size: 1rem; font-weight: 600; color: var(--pgold); margin-top: 2px; }
  .cd-right .stay dd { font-size: 1rem; font-weight: 500; color: #e9d3e6; }
  .stay .ss-wrap { margin-top: 16px; }
  .stay :global(.ss-field) { border-color: #fff; }

  /* gallery */
  .gal { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: clamp(140px, 16vw, 240px); gap: 10px; }
  @media (max-width: 700px) { .gal { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 40vw; } }
  .shot { padding: 0; border: 0; background: var(--plum); cursor: zoom-in; overflow: hidden; display: block; }
  .shot.big { grid-column: span 2; grid-row: span 2; }
  .shot img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.7s var(--ease); }
  .shot:hover img { transform: scale(1.05); }
  .shot:focus-visible { outline: 4px solid var(--pgold); outline-offset: 2px; }
  .lb { border: 0; padding: 0; background: transparent; max-width: min(1280px, 94vw); max-height: 92vh; }
  .lb::backdrop { background: rgba(51, 11, 47, 0.94); }
  .lb img { display: block; max-width: 100%; max-height: 92vh; }
  .lb-x { position: fixed; top: 18px; right: 18px; width: 52px; height: 52px; border: 0; background: var(--pgold); color: var(--plum); cursor: pointer; display: grid; place-items: center; }

  /* campuses */
  .logos { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: 10px; }
  .logos a { display: flex; align-items: center; gap: 14px; padding: 16px; height: 100%; background: #fff; border: 2px solid transparent; text-decoration: none; color: var(--plum); font-weight: 750; line-height: 1.3; transition: border-color 0.2s; }
  .logos a:hover { border-color: var(--coral); }

  /* closer */
  .closer { position: relative; padding: clamp(88px, 12vw, 160px) 0; text-align: center; background: var(--plum); }
  .closer .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .closer::after { content: ''; position: absolute; inset: 0; background: rgba(51, 11, 47, 0.85); }
  .cin { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; }
  .logo-sm { width: min(60vw, 260px); height: auto; margin-bottom: 28px; }
  .cin p { color: #fff; font-size: clamp(1.3rem, 2.4vw, 1.8rem); font-weight: 800; margin: 0 0 32px; }
</style>
