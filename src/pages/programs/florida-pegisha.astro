---
// Florida Pegisha: the statewide Shabbaton and Chabad on Campus Florida's
// signature initiative. This page has its own look (maroon, gold and cream,
// taken from the Pegisha shirts and flyer) instead of the site's blue theme.
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SchoolSearch from '../../components/SchoolSearch.astro';
import CenterLogo from '../../components/CenterLogo.astro';
import Icon from '../../components/Icon.astro';
import { programBySlug } from '../../data/programs';
import { centers } from '../../lib/centers';
import { SITE, img } from '../../lib/site';
import wdthFont from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';

const p = programBySlug['florida-pegisha'];
const path = '/programs/florida-pegisha/';
const REGISTER = 'https://pegishaflorida.com/';
const crumbs = [
  { name: 'Programs', href: '/programs/' },
  { name: 'Florida Pegisha', href: path },
];

const slides = [
  { key: 'fp-havdalah-candle', alt: 'A student holding a lit Havdalah candle as students in Florida Pegisha shirts sing behind her' },
  { key: 'fp-group', alt: 'Four smiling students in Florida Pegisha 2026 shirts' },
  { key: 'fp-havdalah-crowd', alt: 'Students, rabbis and families singing together at Havdalah during the Florida Pegisha' },
].map((s) => ({ ...s, ...img(s.key) }));

const words = ['Shabbat', 'Friends', 'Every campus', 'Music', 'Havdalah', 'Big questions', 'Great food', 'One weekend', 'Orlando'];

const expect = [
  { icon: 'UtensilsCrossed', title: 'Eat and shmooze', text: 'Shabbat dinner and lunch with the whole state at one long table. Nobody leaves hungry.' },
  { icon: 'MessagesSquare', title: 'Learn and grow', text: 'Workshops and honest conversations with rabbis, rebbetzins and students who ask good questions.' },
  { icon: 'Flame', title: 'A full Shabbat', text: 'From candle lighting to Havdalah. For many students, it is the first complete Shabbat of their lives.' },
  { icon: 'Users', title: 'Meet the whole state', text: 'Gainesville, Tallahassee, Orlando, Tampa, Miami, Boca, Fort Myers and more, all in one room.' },
  { icon: 'Music', title: 'Sing and dance', text: 'Havdalah with hundreds of voices, then music and dancing that goes late into Saturday night.' },
  { icon: 'Bus', title: 'Travel with your crew', text: 'You come with friends from your own Chabad House, and leave with friends from every other one.' },
];

const days = [
  {
    day: 'Friday',
    title: 'Arrive and welcome Shabbat',
    items: ['Travel to Orlando with your campus group', 'Check in and grab your Florida Pegisha shirt', 'Candle lighting as Shabbat begins', 'Shabbat services', 'Friday night dinner with every campus', 'Late-night hangouts and conversation'],
  },
  {
    day: 'Shabbat',
    title: 'A day to slow down',
    items: ['Morning services and kiddush', 'Shabbat lunch', 'Workshops and discussions', 'Free time with old and new friends', 'Seudah shlishit, the third Shabbat meal'],
  },
  {
    day: 'Saturday night',
    title: 'Havdalah and celebration',
    items: ['Havdalah with the whole state', 'Live music and dancing', 'A Motzei Shabbat party to close out the weekend'],
  },
];

const gallery = [
  { key: 'fp-havdalah-crowd', alt: 'Students and families singing at Havdalah', cls: 'g-wide' },
  { key: 'fp-workshop', alt: 'A student taking part in a hands-on workshop', cls: '' },
  { key: 'fp-shirts', alt: 'A stack of Florida Pegisha 2026 shirts', cls: '' },
  { key: 'fp-rebbetzin', alt: 'A rebbetzin leading a workshop for students', cls: '' },
  { key: 'fp-group', alt: 'Students in Florida Pegisha shirts', cls: '' },
].map((g) => ({ ...g, ...img(g.key) }));

const faqs = [
  ...p.faqs,
  { q: 'Where is it held?', a: 'The 2026 Florida Pegisha took place in Orlando, right in the middle of the state, so every campus can get there. Your Chabad House will share the location for the next one.' },
  { q: 'What should I bring?', a: 'Nice clothes for Shabbat, something comfortable for Saturday night, and whatever you need for the weekend. Meals are taken care of. Your Chabad House will send a packing list before you go.' },
  { q: 'Can I register on my own?', a: `You can start at <a href="${REGISTER}" rel="noopener">pegishaflorida.com</a>, but it is best to connect with your campus Chabad House too, since you will travel and room with your campus group.` },
];

const flyer = img('fp-flyer');
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: p.metaTitle,
    url: `${SITE.url}${path}`,
    description: p.metaDescription,
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: { '@type': 'Thing', name: 'Florida Pegisha Shabbaton' },
    primaryImageOfPage: { '@type': 'ImageObject', url: `${SITE.url}${slides[1].src}` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })),
  },
];
---
<Base title={p.metaTitle} description={p.metaDescription} path={path} breadcrumbs={crumbs} jsonLd={ld} ogImage={slides[1].src}>
  <Fragment set:html={`<style>@font-face{font-family:'Archivo Wide';font-style:normal;font-display:swap;font-weight:100 900;font-stretch:62% 125%;src:url(${wdthFont}) format('woff2')}</style>`} />
  <link rel="preload" href={wdthFont} as="font" type="font/woff2" crossorigin />
  <div class="fp">
    <!-- HERO -->
    <section class="hero">
      <div class="hero-text">
        <div class="hero-in">
          <Breadcrumbs items={crumbs} />
          <h1><img class="logo" src="/images/pegisha-statewide.webp" alt="Florida Pegisha" width="720" height="588" /></h1>
          <p class="sub">The statewide Shabbaton weekend for Jewish college students.</p>
          <div class="acts">
            <a class="b b-gold" href={REGISTER} rel="noopener">Register <Icon name="ArrowUpRight" size={20} /></a>
            <a class="b b-line" href="#weekend">See the weekend</a>
          </div>
        </div>
      </div>
      <div class="hero-media" data-fps>
        {slides.map((s, i) => (
          <img class:list={['slide', i === 0 && 'on']} src={s.src} srcset={s.srcset} sizes="(max-width: 980px) 100vw, 55vw" width={s.width} height={s.height} alt={s.alt} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" />
        ))}
        <div class="bars" role="group" aria-label="Choose a photo">
          {slides.map((_, i) => <button type="button" aria-label={`Photo ${i + 1}`} aria-pressed={i === 0 ? 'true' : 'false'} data-bar={i}><span></span></button>)}
        </div>
      </div>
    </section>

    <!-- TICKER -->
    <div class="ticker" aria-hidden="true">
      <div class="track">
        {[0, 1].map(() => <span class="run">{words.map((w) => <><span>{w}</span><img src="/flame.webp" alt="" width="22" height="22" /></>)}</span>)}
      </div>
    </div>

    <!-- INTRO -->
    <section class="intro">
      <div class="fpw">
        <h2 class="huge reveal">Every campus.<br /><span>One Shabbat.</span></h2>
        <div class="intro-copy reveal" style="--d:120ms">
          <p class="big">Pegisha means "encounter" in Hebrew. Once a year, the Chabad on Campus centers across Florida bring their students together for a weekend that feels like the whole state is sitting at one Shabbat table.</p>
          <p>The Florida Pegisha is the signature project of Chabad on Campus Florida, the joint initiative of Florida's independently run Chabad Houses. It is where a freshman from Gainesville meets a senior from Boca, where students who have never kept a full Shabbat find out how good one can feel, and where a lot of lasting friendships begin.</p>
        </div>
      </div>
      <dl class="facts fpw reveal">
        <div><dt>Where</dt><dd>Orlando, in 2026</dd></div>
        <div><dt>When</dt><dd>Spring semester</dd></div>
        <div><dt>Who</dt><dd>Jewish students at any Florida college</dd></div>
        <div><dt>Cost</dt><dd>Heavily subsidized</dd></div>
      </dl>
    </section>

    <!-- WHAT TO EXPECT -->
    <section class="expect">
      <div class="fpw">
        <h2 class="h2 reveal">What to expect</h2>
        <div class="tiles">
          {expect.map((e, i) => (
            <div class="tile reveal" style={`--d:${(i % 3) * 90}ms`}>
              <span class="ic"><Icon name={e.icon} size={30} /></span>
              <h3>{e.title}</h3>
              <p>{e.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- WEEKEND -->
    <section class="weekend" id="weekend">
      <div class="fpw">
        <div class="wk-head reveal">
          <h2 class="h2">The weekend</h2>
          <p>A taste of what the weekend looks like. Details change a little every year.</p>
        </div>
        <div class="daytabs" role="tablist" aria-label="Weekend schedule">
          {days.map((d, i) => <button role="tab" id={`dt-${i}`} aria-controls={`dp-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}><span class="n">{String(i + 1).padStart(2, '0')}</span>{d.day}</button>)}
        </div>
        {days.map((d, i) => (
          <div class="daypanel" role="tabpanel" id={`dp-${i}`} aria-labelledby={`dt-${i}`} hidden={i !== 0}>
            <h3>{d.title}</h3>
            <ol>{d.items.map((it) => <li>{it}</li>)}</ol>
          </div>
        ))}
      </div>
    </section>

    <!-- GALLERY -->
    <section class="gallery">
      <div class="fpw">
        <div class="gal-head reveal">
          <h2 class="h2">Florida Pegisha 2026</h2>
          <p>Moments from last spring in Orlando.</p>
        </div>
        <div class="gal">
          {gallery.map((g, i) => (
            <button type="button" class:list={['shot', g.cls]} data-full={g.src} data-alt={g.alt} aria-label={`View photo: ${g.alt}`}>
              <img src={`/images/${g.key}-640.webp`} srcset={g.srcset} sizes="(max-width: 700px) 100vw, 50vw" width={g.width} height={g.height} alt={g.alt} loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
      </div>
      <dialog class="lb" aria-label="Photo">
        <button type="button" class="lb-x" aria-label="Close"><Icon name="X" size={28} /></button>
        <img alt="" />
      </dialog>
    </section>

    <!-- CAMPUSES -->
    <section class="campuses">
      <div class="fpw">
        <div class="cp-head reveal">
          <h2 class="h2">Students come from all of these</h2>
          <p>Every Chabad on Campus center in Florida is part of the Florida Pegisha.</p>
        </div>
        <ul class="logos">
          {centers.map((c) => (
            <li><a href={c.url}><CenterLogo center={c} size={60} /><span>{c.primaryCampus.name}</span></a></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- JOIN -->
    <section class="join" id="join">
      <div class="fpw join-grid">
        <div class="reveal">
          <h2 class="h2">Save your spot</h2>
          <ol class="steps">
            <li><strong>Find your Chabad House</strong><span>Every Florida Chabad on Campus center brings a group.</span></li>
            <li><strong>Talk to your rabbi and rebbetzin</strong><span>They will share the dates, the price for your campus and how your group is traveling.</span></li>
            <li><strong>Register</strong><span>Sign up at pegishaflorida.com and get ready for the weekend.</span></li>
          </ol>
          <a class="b b-maroon" href={REGISTER} rel="noopener">Register at pegishaflorida.com <Icon name="ArrowUpRight" size={20} /></a>
        </div>
        <div class="join-side reveal" style="--d:120ms">
          <div class="finder">
            <h3>Find your Chabad House</h3>
            <SchoolSearch id="fp-search" size="md" label="Your school" showLabel={false} />
          </div>
          <figure class="flyer">
            <img src={flyer.src} srcset={flyer.srcset} sizes="(max-width: 980px) 90vw, 420px" width={flyer.width} height={flyer.height} alt="The Florida Pegisha 2026 flyer: statewide Shabbaton weekend in Orlando, April 17 and 18, 2026, with logos of the participating Chabad centers" loading="lazy" />
            <figcaption>The 2026 flyer</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faqs">
      <div class="fpw faq-grid">
        <h2 class="h2 reveal">Questions</h2>
        <div class="qa">
          {faqs.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}<Icon name="Plus" size={22} class="pl" /></summary>
              <p set:html={f.a} />
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- INTERNATIONAL -->
    <section class="intl">
      <a class="fpw intl-row" href="/programs/pegisha/">
        <img src="/images/pegisha-wordmark.webp" alt="" width="600" height="185" loading="lazy" />
        <div>
          <h2>Want an even bigger Shabbat?</h2>
          <p>Each fall, the International Pegisha brings students from around the world to Crown Heights, Brooklyn. Florida students go with their own Chabad House.</p>
        </div>
        <span class="go">International Pegisha <Icon name="ArrowRight" size={22} /></span>
      </a>
    </section>

    <!-- FINAL -->
    <section class="final">
      <img class="wm" src="/flame.webp" alt="" width="512" height="512" loading="lazy" />
      <div class="fpw">
        <h2>See you at the<br /><span>Florida Pegisha</span></h2>
        <div class="acts">
          <a class="b b-gold" href={REGISTER} rel="noopener">Register <Icon name="ArrowUpRight" size={20} /></a>
          <a class="b b-line" href="/campuses/">Find your Chabad House</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // hero slideshow
  const slides = Array.from(document.querySelectorAll<HTMLImageElement>('[data-fps] .slide'));
  const bars = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-bar]'));
  let cur = 0;
  let timer: number | undefined;
  const show = (n: number) => {
    cur = (n + slides.length) % slides.length;
    slides.forEach((s, i) => s.classList.toggle('on', i === cur));
    bars.forEach((b, i) => b.setAttribute('aria-pressed', String(i === cur)));
  };
  const auto = () => { if (!reduce) { clearInterval(timer); timer = window.setInterval(() => show(cur + 1), 5500); } };
  bars.forEach((b, i) => b.addEventListener('click', () => { show(i); auto(); }));
  auto();

  // weekend tabs
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.daytabs [role=tab]'));
  const select = (t: HTMLButtonElement) => {
    tabs.forEach((x) => {
      const on = x === t;
      x.setAttribute('aria-selected', String(on));
      x.tabIndex = on ? 0 : -1;
      document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
    });
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (d) { const n = tabs[(i + d + tabs.length) % tabs.length]; select(n); n.focus(); }
    });
  });

  // gallery lightbox
  const lb = document.querySelector<HTMLDialogElement>('.lb')!;
  const lbImg = lb.querySelector('img')!;
  document.querySelectorAll<HTMLButtonElement>('.shot').forEach((b) =>
    b.addEventListener('click', () => {
      lbImg.src = b.dataset.full!;
      lbImg.alt = b.dataset.alt!;
      lb.showModal();
    }),
  );
  lb.querySelector('.lb-x')!.addEventListener('click', () => lb.close());
  lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
</script>

<style>
  .fp {
    --m: #7c1a2e;
    --m-deep: #4b0f1c;
    --m-ink: #2a0810;
    --g: #ffc70b;
    --cr: #fbf3e4;
    --cr-2: #f4e8d2;
    --tx: #2a0810;
    --in: min(1320px, 100% - 2 * clamp(20px, 5vw, 72px));
    color: var(--tx);
    background: var(--cr);
    overflow: hidden;
  }
  .fpw { width: var(--in); margin-inline: auto; }
  .fp :global(h1), .fp :global(h2), .fp h3 { font-family: 'Archivo Wide', var(--font); font-stretch: 125%; letter-spacing: -0.01em; }

  /* buttons */
  .b { display: inline-flex; align-items: center; gap: 10px; padding: 18px 28px; font: 800 1rem/1.1 var(--font); text-decoration: none; border: 2px solid transparent; transition: background 0.2s, color 0.2s, border-color 0.2s; }
  .b :global(.icon) { transition: transform 0.2s var(--ease); }
  .b:hover :global(.icon) { transform: translate(3px, -3px); }
  .b-gold { background: var(--g); color: var(--m-ink); }
  .b-gold:hover { background: #fff; }
  .b-line { border-color: rgba(255, 255, 255, 0.55); color: #fff; }
  .b-line:hover { border-color: var(--g); color: var(--g); }
  .b-maroon { background: var(--m); color: #fff; }
  .b-maroon:hover { background: var(--m-ink); }
  .acts { display: flex; flex-wrap: wrap; gap: 12px; }

  /* hero */
  .hero { display: grid; grid-template-columns: minmax(0, 46fr) minmax(0, 54fr); min-height: clamp(600px, 88vh, 880px); background: var(--m); }
  @media (max-width: 980px) { .hero { grid-template-columns: minmax(0, 1fr); } }
  .hero-text { display: flex; align-items: center; padding: clamp(48px, 7vw, 104px) clamp(20px, 5vw, 72px); color: #fff; }
  .hero-in { max-width: 560px; margin-left: auto; width: 100%; }
  @media (max-width: 980px) { .hero-in { margin: 0; } }
  .hero-in :global(.crumbs), .hero-in :global(.crumbs a) { color: #f3c9d1; }
  h1 { margin: 40px 0 28px; line-height: 0; }
  .logo { display: block; width: min(100%, 440px); height: auto; }
  .sub { font-size: clamp(1.15rem, 1.6vw, 1.35rem); color: #f7dfe4; margin: 0 0 40px; max-width: 30ch; line-height: 1.5; }
  .hero-media { position: relative; min-height: 380px; background: var(--m-deep); }
  .slide { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 1.1s ease; }
  .slide.on { opacity: 1; }
  .bars { position: absolute; left: 28px; right: 28px; bottom: 26px; display: flex; gap: 8px; }
  .bars button { flex: 1; max-width: 90px; height: 24px; background: none; border: 0; padding: 0; cursor: pointer; display: flex; align-items: center; }
  .bars span { display: block; width: 100%; height: 4px; background: rgba(255, 255, 255, 0.45); transition: background 0.3s; }
  .bars button[aria-pressed='true'] span { background: var(--g); }

  /* ticker */
  .ticker { background: var(--g); overflow: hidden; border-block: 2px solid var(--m-ink); }
  .track { display: flex; width: max-content; animation: tick 38s linear infinite; }
  @media (prefers-reduced-motion: reduce) { .track { animation: none; } }
  @keyframes tick { to { transform: translateX(-50%); } }
  .run { display: flex; align-items: center; }
  .run span { font: 900 clamp(1.1rem, 2vw, 1.5rem)/1 'Archivo Wide', var(--font); font-stretch: 125%; text-transform: uppercase; color: var(--m-ink); padding: 20px 26px; white-space: nowrap; }
  .run img { width: 22px; height: 22px; filter: brightness(0) saturate(100%) invert(10%) sepia(40%) saturate(3000%) hue-rotate(330deg); }

  /* intro */
  .intro { padding: clamp(88px, 12vw, 160px) 0 clamp(64px, 8vw, 112px); }
  .intro > .fpw:first-child { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(36px, 6vw, 104px); align-items: start; }
  @media (max-width: 900px) { .intro > .fpw:first-child { grid-template-columns: minmax(0, 1fr); } }
  .huge { font-size: clamp(2.6rem, 5.6vw, 5rem); line-height: 0.98; margin: 0; font-weight: 900; color: var(--m-ink); }
  .huge span { color: var(--m); }
  .intro-copy .big { font-size: clamp(1.2rem, 1.7vw, 1.45rem); line-height: 1.55; color: var(--m-ink); margin-top: 0; }
  .intro-copy p { color: #5b3a40; }
  .facts { margin-top: clamp(56px, 7vw, 96px); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 3px solid var(--m-ink); }
  @media (max-width: 900px) { .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .facts div { padding: 22px 20px 0 0; }
  .facts dt { font-size: 0.9rem; font-weight: 800; color: var(--m); margin-bottom: 6px; }
  .facts dd { margin: 0; font: 800 clamp(1.1rem, 1.6vw, 1.35rem)/1.25 var(--font); color: var(--m-ink); }

  /* expect */
  .expect { background: var(--m-deep); color: #fff; padding: clamp(88px, 11vw, 150px) 0; }
  .h2 { font-size: clamp(2.2rem, 4.4vw, 3.8rem); line-height: 1; font-weight: 900; margin: 0 0 clamp(40px, 5vw, 64px); }
  .expect .h2 { color: #fff; }
  .tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid rgba(255, 255, 255, 0.2); border-left: 1px solid rgba(255, 255, 255, 0.2); }
  @media (max-width: 900px) { .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 580px) { .tiles { grid-template-columns: minmax(0, 1fr); } }
  .tile { padding: clamp(28px, 3.5vw, 44px); border-right: 1px solid rgba(255, 255, 255, 0.2); border-bottom: 1px solid rgba(255, 255, 255, 0.2); transition: background 0.25s; }
  .tile:hover { background: var(--m); }
  .ic { display: grid; place-items: center; width: 60px; height: 60px; background: var(--g); color: var(--m-ink); margin-bottom: 26px; }
  .tile h3 { font-size: 1.35rem; margin: 0 0 10px; color: #fff; }
  .tile p { margin: 0; color: #eccbd2; }

  /* weekend */
  .weekend { padding: clamp(88px, 11vw, 150px) 0; }
  .wk-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 12px 40px; margin-bottom: clamp(32px, 4vw, 48px); }
  .wk-head .h2 { margin: 0; color: var(--m-ink); }
  .wk-head p { margin: 0; color: #6a4a50; max-width: 38ch; }
  .daytabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-bottom: 3px solid var(--m-ink); }
  .daytabs button { font: 850 clamp(1rem, 2vw, 1.5rem)/1.1 'Archivo Wide', var(--font); font-stretch: 125%; text-align: left; padding: 22px 20px; border: 0; background: transparent; color: #8a6a70; cursor: pointer; display: flex; flex-direction: column; gap: 10px; transition: background 0.2s, color 0.2s; }
  .daytabs .n { font: 800 0.85rem var(--font); font-stretch: 100%; }
  .daytabs button:hover { color: var(--m); }
  .daytabs button[aria-selected='true'] { background: var(--m); color: #fff; }
  .daypanel { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 24px clamp(40px, 6vw, 96px); padding: clamp(36px, 5vw, 64px) 0 0; }
