---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProgramCard from '../../components/ProgramCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { programs } from '../../data/programs';
import { SITE, img } from '../../lib/site';

const cats = [
  { name: 'Learning', icon: 'BookOpen', text: 'Courses and fellowships taught at your campus Chabad House.' },
  { name: 'Shabbatons', icon: 'Flame', text: 'Weekends with Jewish students from many campuses: the Florida Pegisha and the International Pegisha.' },
  { name: 'Travel & Israel', icon: 'Plane', text: 'Birthright with your campus Chabad and heritage trips.' },
  { name: 'Care & Home', icon: 'HeartHandshake', text: 'Chicken soup when you are sick and a mezuzah for your door.' },
] as const;
const anchor = (s: string) => s.toLowerCase().replace(/[^a-z]+/g, '-');
const hero = img('fl-group');
const side = img('fl-gators');
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Chabad on Campus programs for Florida college students',
    url: `${SITE.url}/programs/`,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: programs.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}/programs/${p.slug}/`, name: p.name })),
    },
  },
];
---
<Base
  title="Programs for Jewish College Students in Florida"
  description="Florida Pegisha, JewishU, Sinai Scholars, Birthright Israel, International Pegisha, Your Israel, Living Links, soup delivery and mezuzah loans: Chabad on Campus programs for Florida students."
  path="/programs/"
  breadcrumbs={[{ name: 'Programs', href: '/programs/' }]}
  jsonLd={ld}
>
  <section class="ihero">
    <img class="bg" src={hero.src} srcset={hero.srcset} sizes="100vw" width={hero.width} height={hero.height} alt="" fetchpriority="high" />
    <div class="wrap">
      <div class="box band-blue">
        <Breadcrumbs items={[{ name: 'Programs', href: '/programs/' }]} />
        <h1>Learn, travel and grow</h1>
        <p class="lead">Programs for Florida students, run through your local Chabad House.</p>
      </div>
    </div>
  </section>

  <nav class="catnav" aria-label="Program categories">
    <div class="wrap cn">
      {cats.map((c) => <a href={`#${anchor(c.name)}`}><Icon name={c.icon} size={22} /> {c.name}</a>)}
    </div>
  </nav>

  {cats.map((cat, i) => {
    const list = programs.filter((p) => p.category === cat.name);
    return (
      <section class:list={['section', i % 2 === 1 && 'band-cream']} id={anchor(cat.name)}>
        <div class="wrap">
          <div class="chead reveal">
            <span class="bubble lg gold"><Icon name={cat.icon} size={32} /></span>
            <div>
              <h2>{cat.name}</h2>
              <p class="lead">{cat.text}</p>
            </div>
          </div>
          <div class="grid grid-3">
            {list.map((p) => <ProgramCard program={p} headingLevel="h3" />)}
          </div>
        </div>
      </section>
    );
  })}

  <section class="section band-wash">
    <div class="wrap split">
      <div class="reveal">
        <h2>It all starts with your Chabad House</h2>
        <p class="lead">Your rabbi and rebbetzin will sign you up, answer your questions and often travel with you.</p>
        <a class="btn btn-blue" href="/campuses/">Find your Chabad House <Icon name="ArrowRight" size={20} /></a>
      </div>
      <div class="photo sp"><img src={side.src} srcset={side.srcset} sizes="(max-width: 900px) 100vw, 50vw" width={side.width} height={side.height} alt="Chabad UF students gathered under the Jewish Student Center tent on campus" loading="lazy" /></div>
    </div>
  </section>

  <CtaBand title="New to Chabad on Campus?" text="Read what to expect and how to get involved at your school." primary={{ href: '/faq/', label: 'Read the FAQ' }} secondary={{ href: '/jewish-life-on-campus/', label: 'Jewish life on campus' }} />
</Base>

<style>
  .ihero { position: relative; min-height: clamp(480px, 66vh, 680px); display: flex; align-items: flex-end; background: var(--blue-night); }
  .ihero .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ihero .wrap { position: relative; width: 100%; }
  .box { max-width: 680px; padding: clamp(36px, 5vw, 64px); }
  .box h1 { margin-bottom: 16px; }
  .box .lead { margin: 0; }
  .catnav { border-bottom: 2px solid var(--ink); }
  .cn { display: flex; flex-wrap: wrap; }
  .cn a { display: inline-flex; align-items: center; gap: 10px; padding: 22px 28px 22px 0; margin-right: 12px; font-weight: 750; font-size: 1.05rem; text-decoration: none; color: var(--ink); }
  .cn a:hover { color: var(--blue); }
  .cn a :global(.icon) { color: var(--blue); }
  .chead { display: flex; gap: 24px; align-items: flex-start; margin-bottom: clamp(36px, 5vw, 56px); }
  .chead h2 { margin-bottom: 8px; }
  .chead .lead { margin: 0; }
  .sp { aspect-ratio: 4 / 3; }
  .split .lead { margin-bottom: 32px; }
</style>
