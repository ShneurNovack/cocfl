---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProgramCard from '../../components/ProgramCard.astro';
import SchoolSearch from '../../components/SchoolSearch.astro';
import Faq from '../../components/Faq.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { programs, programBySlug, type Program } from '../../data/programs';
import { SITE, img } from '../../lib/site';

export function getStaticPaths() {
  return programs.filter((p) => !p.custom).map((p) => ({ params: { slug: p.slug }, props: { program: p } }));
}
interface Props { program: Program }
const { program: p } = Astro.props;
const related = p.related.map((s) => programBySlug[s]).filter(Boolean);
const hero = img(p.image);
const crumbs = [
  { name: 'Programs', href: '/programs/' },
  { name: p.name, href: `/programs/${p.slug}/` },
];
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: p.metaTitle,
    url: `${SITE.url}/programs/${p.slug}/`,
    description: p.metaDescription,
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: { '@type': 'Thing', name: p.name, ...(p.officialLinks[0] ? { sameAs: p.officialLinks[0].href } : {}) },
    primaryImageOfPage: { '@type': 'ImageObject', url: `${SITE.url}${hero.src}` },
  },
];
const glance = [
  { icon: 'Users', title: "Who it's for", text: p.audience },
  { icon: 'CalendarDays', title: 'Format', text: p.format },
  { icon: 'Tag', title: 'Cost', text: p.cost },
];
---
<Base title={p.metaTitle} description={p.metaDescription} path={`/programs/${p.slug}/`} breadcrumbs={crumbs} jsonLd={ld} ogImage={hero.src}>
  <section class="phero">
    <div class="ptext band-blue">
      <div class="pin">
        <Breadcrumbs items={crumbs} />
        {p.logo && <img class="plogo" src={p.logo} alt={`${p.name} logo`} width="180" height="90" />}
        <h1>{p.name}</h1>
        <p class="lead">{p.tagline}</p>
      </div>
    </div>
    <div class="pmedia">
      <img src={hero.src} srcset={hero.srcset} sizes="(max-width: 960px) 100vw, 55vw" width={hero.width} height={hero.height} alt={p.imageAlt} fetchpriority="high" decoding="async" />
    </div>
  </section>

  <section class="glance band-gold">
    <div class="wrap gg">
      {glance.map((g) => (
        <div>
          <Icon name={g.icon} size={28} />
          <h2>{g.title}</h2>
          <p>{g.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="wrap body">
      <div class="prose">
        {p.intro.map((t, i) => <p class:list={[i === 0 && 'lead']} set:html={t} />)}
        {p.sections.map((s) => (
          <>
            <h2>{s.h2}</h2>
            {s.body.map((t) => <p>{t}</p>)}
            {s.list && <ul>{s.list.map((li) => <li>{li}</li>)}</ul>}
          </>
        ))}
      </div>
      <aside class="join">
        <span class="bubble lg gold"><Icon name="MapPin" size={30} /></span>
        <h2>Join through your Chabad House</h2>
        <p>Your campus rabbi and rebbetzin can tell you when {p.shortName} runs next and help you sign up.</p>
        <SchoolSearch id="prog-search" size="md" label="Find your Chabad House" />
        {p.officialLinks.length > 0 && (
          <ul class="ext">
            {p.officialLinks.map((l) => <li><a href={l.href} rel="noopener">{l.label} <Icon name="ArrowUpRight" size={18} /></a></li>)}
          </ul>
        )}
      </aside>
    </div>
  </section>

  <section class="section band-cream">
    <div class="wrap narrow">
      <h2 class="fh">Questions about {p.shortName}</h2>
      <Faq items={p.faqs} open />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="fh">More ways to get involved</h2>
      <div class="grid grid-3">{related.map((r) => <ProgramCard program={r} />)}</div>
    </div>
  </section>

  <CtaBand title={`Interested in ${p.shortName}?`} text="Find your campus and reach out to your rabbi and rebbetzin." />
</Base>

<style>
  .phero { display: grid; grid-template-columns: minmax(0, 45fr) minmax(0, 55fr); min-height: clamp(460px, 68vh, 660px); }
  @media (max-width: 960px) { .phero { grid-template-columns: minmax(0, 1fr); } }
  .ptext { display: flex; align-items: center; padding: clamp(48px, 7vw, 96px) var(--gutter); }
  .pin { max-width: 540px; margin-left: auto; width: 100%; }
  @media (max-width: 960px) { .pin { margin: 0; } }
  .plogo { height: 72px; width: auto; margin-bottom: 28px; background: #fff; padding: 10px; }
  .ptext h1 { margin-bottom: 20px; }
  .ptext .lead { margin: 0; max-width: 34ch; }
  .pmedia { position: relative; min-height: 320px; background: var(--blue-night); }
  .pmedia img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  .glance { padding: clamp(48px, 6vw, 72px) 0; }
  .gg { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(28px, 4vw, 64px); }
  @media (max-width: 800px) { .gg { grid-template-columns: minmax(0, 1fr); } }
  .gg h2 { font-size: 1.15rem; margin: 14px 0 6px; }
  .gg p { margin: 0; color: var(--ink-2); }

  .body { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: clamp(48px, 7vw, 112px); align-items: start; }
  @media (max-width: 1000px) { .body { grid-template-columns: minmax(0, 1fr); } }
  .prose > .lead { font-size: 1.3rem; color: var(--ink); }
  .join { position: sticky; top: 110px; background: var(--blue-wash); padding: 32px; display: grid; gap: 16px; }
  .join h2 { font-size: 1.5rem; margin: 8px 0 0; }
  .join p { margin: 0; color: var(--ink-2); }
  .join :global(.ss-field) { border-color: var(--ink); }
  .join :global(.ss .btn) { padding: 0 16px; }
  .ext { list-style: none; padding: 0; margin: 8px 0 0; display: grid; gap: 6px; }
  .ext a { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; text-decoration: none; }
  .fh { margin-bottom: 36px; }
</style>
