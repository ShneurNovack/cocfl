---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { stats } from '../lib/centers';
import { SITE } from '../lib/site';

const groups = [
  {
    title: 'About Chabad on Campus',
    items: [
      { q: 'What is Chabad on Campus?', a: 'Chabad on Campus is a network of Chabad Houses serving Jewish students at more than 950 colleges and universities worldwide. Each Chabad House is a home away from home run by a rabbi and his wife, offering Shabbat dinners, holiday celebrations, classes, trips and personal support.' },
      { q: 'What does "Chabad" mean?', a: 'Chabad is a Hebrew acronym for Chochmah, Binah and Da\'at: wisdom, understanding and knowledge. It is the name of a Chassidic movement founded in the 18th century, also known as Lubavitch after the town in Russia that was its home for more than a century.' },
      { q: 'Who runs a Chabad House?', a: 'A husband and wife, usually called the rabbi and rebbetzin, who serve as <em>shluchim</em>, emissaries of the Lubavitcher Rebbe. They live near campus and often raise their own families alongside the students they serve.' },
      { q: 'What is a rebbetzin?', a: 'Rebbetzin is the traditional title for a rabbi\'s wife. At Chabad on Campus, the rebbetzin is a full partner in leading the Chabad House, teaching, mentoring and hosting students.' },
      { q: 'Is Chabad on Campus the same as Hillel?', a: 'No. They are separate organizations. Hillel is a campus organization for Jewish student life, and Chabad on Campus centers are Chabad Houses run by a rabbi and rebbetzin. Many campuses have both, and many students take part in both.' },
    ],
  },
  {
    title: 'Getting involved',
    items: [
      { q: 'Do I need to be religious or Orthodox to go to Chabad?', a: 'Not at all. Chabad on Campus welcomes Jewish students of every background, whether you grew up observant, secular or somewhere in between. Research on Chabad on Campus has found that almost 90 percent of participants do not come from Orthodox homes.' },
      { q: 'Does it cost anything?', a: 'There is no membership and no dues. Shabbat dinners and holiday events are free or nearly free, and many programs are subsidized. Chabad Houses are supported by donors, parents and alumni.' },
      { q: 'Is there a Chabad at my school?', a: `Chabad on Campus Florida includes ${stats.centers} centers serving ${stats.campuses} Florida colleges and universities. <a href="/campuses/">Search the directory</a> by school name, abbreviation or city. Outside Florida, check the <a href="https://chabadoncampus.org/">Chabad on Campus International</a> directory.` },
      { q: 'What happens at a Shabbat dinner?', a: 'Candle lighting, a short and friendly service for anyone who wants it, Kiddush, challah and a long home-cooked dinner with friends. Read more about <a href="/jewish-life-on-campus/shabbat/">Shabbat on campus</a>.' },
      { q: 'Can I bring a friend who is not Jewish?', a: 'Many Chabad Houses are happy to welcome friends who are curious to learn. Ask your local Chabad House about their guidelines for events.' },
      { q: 'I\'m a graduate student. Is Chabad for me too?', a: 'Yes. Chabad Houses welcome graduate, law and medical students, and some offer programs specifically for grad students.' },
      { q: 'How do I get involved?', a: 'Come to a Shabbat dinner or event, or send the rabbi and rebbetzin a message to introduce yourself. Find contact details for your school in the <a href="/campuses/">directory</a>.' },
    ],
  },
  {
    title: 'Programs and support',
    items: [
      { q: 'What programs does Chabad on Campus offer?', a: 'Beyond Shabbat and holidays, students can join <a href="/programs/jewishu/">JewishU</a> courses, the <a href="/programs/sinai-scholars/">Sinai Scholars Society</a>, <a href="/programs/birthright-israel/">Birthright Israel with Chabad</a>, <a href="/programs/pegisha/">Pegisha Shabbatons</a>, <a href="/programs/living-links/">Living Links</a> and more. See <a href="/programs/">all programs</a>.' },
      { q: 'Does Chabad offer kosher food?', a: 'Every Chabad House serves kosher Shabbat and holiday meals, and many Florida centers offer kosher meal plans, kosher dining or Passover meals. See <a href="/jewish-life-on-campus/kosher-food/">kosher food on campus</a>.' },
      { q: 'Can parents contact the Chabad House?', a: 'Yes. Parents are welcome to reach out to introduce their child or share a concern. See our <a href="/parents/">resources for parents</a>.' },
      { q: 'How is Chabad on Campus Florida related to Chabad on Campus International?', a: 'Chabad on Campus Florida is a regional initiative of the Florida Chabad on Campus centers. Chabad on Campus International supports Chabad Houses worldwide, including every center in Florida.' },
    ],
  },
];
const strip = (s: string) => s.replace(/<[^>]+>/g, '');
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: groups.flatMap((g) => g.items).map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: strip(f.a) } })),
  },
];
const crumbs = [{ name: 'FAQ', href: '/faq/' }];
---
<Base
  title="Chabad on Campus FAQ: Questions From Students & Parents"
  description="Common questions about Chabad on Campus: what it is, who runs a Chabad House, whether you need to be religious, cost, Shabbat dinners, kosher food and programs."
  path="/faq/"
  breadcrumbs={crumbs}
  jsonLd={ld}
>
  <section class="page-hero band-blue">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <h1>Frequently asked questions about Chabad on Campus</h1>
      <p class="lead">Everything students and parents usually ask before their first visit to a Chabad House.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap narrow">
      {groups.map((g) => (
        <div class="group">
          <h2>{g.title}</h2>
          <Faq items={g.items} />
        </div>
      ))}
    </div>
  </section>
  <CtaBand />
</Base>

<style>
  .group + .group { margin-top: 48px; }
</style>
