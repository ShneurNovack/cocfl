---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CenterCard from '../../components/CenterCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { centers, allColleges, stats, stateAbbr } from '../../lib/centers';
import FloridaMap from '../../components/FloridaMap.astro';
import Icon from '../../components/Icon.astro';
import { SITE } from '../../lib/site';

const colleges = allColleges();
const sorted = [...centers].sort((a, b) => a.primaryCampus.name.localeCompare(b.primaryCampus.name));
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Chabad on Campus Florida directory',
    url: `${SITE.url}/campuses/`,
    about: 'Chabad on Campus centers serving Jewish students at Florida colleges and universities',
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: centers.length,
      itemListElement: sorted.map((c, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}${c.url}`, name: `Chabad at ${c.primaryCampus.name}` })),
    },
  },
];
---
<Base
  title="Find Chabad at Your College in Florida | Campus Directory"
  description={`Is there a Chabad at your school? Search all ${stats.centers} Chabad on Campus centers serving ${stats.campuses} Florida colleges and universities by school, abbreviation, city or rabbi.`}
  path="/campuses/"
  breadcrumbs={[{ name: 'Find Your Campus', href: '/campuses/' }]}
  jsonLd={ld}
>
  <section class="page-hero band-blue dhero">
    <div class="wrap">
      <Breadcrumbs items={[{ name: 'Find Your Campus', href: '/campuses/' }]} />
      <h1>Find Chabad at your college</h1>
      <p class="lead">Every Chabad on Campus center in Florida, and every school they welcome.</p>
      <div class="search" role="search">
        <label for="q" class="visually-hidden">Search Florida campuses</label>
        <Icon name="Search" size={24} class="si" />
        <input id="q" type="search" placeholder="Search by school, city or rabbi" autocomplete="off" spellcheck="false" />
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="bar">
        <p class="count" id="count" aria-live="polite">{centers.length} Chabad centers serving {stats.campuses} Florida campuses</p>
        <div class="views" role="group" aria-label="View">
          <button type="button" data-view="grid" aria-pressed="true"><Icon name="LayoutGrid" size={18} /> Grid</button>
          <button type="button" data-view="map" aria-pressed="false"><Icon name="Map" size={18} /> Map</button>
        </div>
      </div>
      <div class="mapview" id="mapview" hidden><FloridaMap /></div>
      <div class="grid grid-3" id="results">
        {sorted.map((c) => <CenterCard center={c} headingLevel="h2" />)}
      </div>
      <div class="empty" id="empty" hidden>
        <h2>No Florida center matches &ldquo;<span id="empty-q"></span>&rdquo;</h2>
        <p>Try the school's full name or its abbreviation, or browse the list of every Florida college below. Chabad also serves many campuses through local Chabad centers that are not listed here. The <a href="https://chabadoncampus.org/" rel="noopener">Chabad on Campus International directory</a> covers more than 950 campuses worldwide.</p>
        <button type="button" class="btn btn-blue" id="clear">Show all Florida centers</button>
      </div>
    </div>
  </section>

  <section class="section band-cream" id="colleges">
    <div class="wrap">
      <h2>Every Florida college in the directory</h2>
      <p class="lead narrow">Some Chabad centers serve several nearby schools. Find your college below to see which Chabad House is yours.</p>
      <div class="table-wrap">
        <table>
          <thead><tr><th scope="col">College or university</th><th scope="col">Chabad center</th><th scope="col">City</th></tr></thead>
          <tbody>
            {colleges.map((r) => (
              <tr>
                <td>
                  <a href={r.campus.primary ? r.center.url : `${r.center.url}#${r.campus.anchor}`}>{r.campus.name}</a>
                  {r.campus.abbr && <span class="abbr"> ({r.campus.abbr})</span>}
                </td>
                <td>{r.center.officialName}</td>
                <td>{r.center.city}, {stateAbbr(r.center.address?.state ?? null)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>


  <CtaBand
    title="New to Chabad on Campus?"
    text="Learn what a Chabad House is, who it is for and what to expect at your first Shabbat dinner."
    primary={{ href: '/faq/', label: 'Read the FAQ' }}
    secondary={{ href: '/jewish-life-on-campus/florida/', label: 'Jewish life at Florida colleges' }}
  />
</Base>

<script>
  const STOP = new Set(['the', 'of', 'at', 'chabad', 'in', 'a', 'and', 'on', 'campus', 'house']);
  const norm = (s: string) =>
    s.toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '').replace(/&/g, ' and ').replace(/[@'’.]/g, '').replace(/[^a-z0-9]+/g, ' ').trim();
  function lev(a: string, b: string, max: number) {
    if (Math.abs(a.length - b.length) > max) return max + 1;
    let prev = Array.from({ length: b.length + 1 }, (_, i) => i);
    for (let i = 1; i <= a.length; i++) {
      const cur = [i];
      let rowMin = i;
      for (let j = 1; j <= b.length; j++) {
        cur[j] = Math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));
        rowMin = Math.min(rowMin, cur[j]);
      }
      if (rowMin > max) return max + 1;
      prev = cur;
    }
    return prev[b.length];
  }
  const tokenMatch = (q: string, words: string[]) => {
    for (const w of words) {
      if (w.startsWith(q)) return w === q ? 3 : 2;
    }
    const tol = q.length >= 7 ? 2 : q.length >= 4 ? 1 : 0;
    if (tol) for (const w of words) if (lev(q, w.slice(0, q.length + tol), tol) <= tol) return 1;
    return 0;
  };

  const input = document.getElementById('q') as HTMLInputElement;
  const grid = document.getElementById('results')!;
  const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-center]'));
  const index = cards.map((el) => {
    const text = norm(el.dataset.search || '');
    const [pname, pabbr] = (el.dataset.primary || '|').split('|');
    return { el, text, words: Array.from(new Set(text.split(' '))), pname: norm(pname), pabbr: norm(pabbr) };
  });
  const count = document.getElementById('count')!;
  const empty = document.getElementById('empty')!;
  const emptyQ = document.getElementById('empty-q')!;
  const total = count.textContent;

  function run() {
    const raw = input.value;
    const q = norm(raw);
    const tokens = q.split(' ').filter((t) => t && !STOP.has(t));
    let shown = 0;
    const ranked: { el: HTMLElement; score: number }[] = [];
    for (const item of index) {
      let score = 0;
      let ok = true;
      for (const t of tokens) {
        const s = tokenMatch(t, item.words);
        if (!s) { ok = false; break; }
        score += s;
      }
      if (ok && q.length > 2 && item.text.includes(q)) score += 10;
      if (ok && q && item.pabbr === q) score += 20;
      else if (ok && q.length > 2 && item.pname.startsWith(q)) score += 15;
      else if (ok && q.length > 2 && item.pname.includes(q)) score += 6;
      item.el.hidden = !ok;
      if (ok) { shown++; ranked.push({ el: item.el, score }); }
    }
    ranked.sort((a, b) => b.score - a.score).forEach((r, i) => (r.el.style.order = String(tokens.length ? i : 0)));
    empty.hidden = shown > 0;
    emptyQ.textContent = raw;
    count.textContent = !tokens.length ? total : `${shown} ${shown === 1 ? 'center matches' : 'centers match'}${raw.trim() ? ` "${raw.trim()}"` : ''}`;
  }

  input.addEventListener('input', run);
  document.getElementById('clear')!.addEventListener('click', () => {
    input.value = '';
    run();
    input.focus();
  });
  const views = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-view]'));
  const mapview = document.getElementById('mapview')!;
  views.forEach((b) => b.addEventListener('click', () => {
    views.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    const map = b.dataset.view === 'map';
    mapview.hidden = !map;
    grid.hidden = map;
  }));
  const initial = new URLSearchParams(location.search).get('q');
  if (initial) { input.value = initial; run(); }
</script>

<style>
  .dhero { padding-bottom: clamp(64px, 9vw, 112px); }
  .dhero .lead { margin-bottom: clamp(32px, 4vw, 48px); }
  .search { position: relative; max-width: 760px; }
  .search :global(.si) { position: absolute; left: 22px; top: 50%; transform: translateY(-50%); color: var(--muted); }
  .search input { width: 100%; font: 550 1.2rem var(--font); padding: 24px 24px 24px 62px; border: 0; color: var(--ink); background: #fff; }
  .search input:focus { outline: 3px solid var(--gold); outline-offset: 0; }
  .bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 32px; padding-bottom: 20px; border-bottom: 2px solid var(--ink); }
  .count { font-weight: 700; margin: 0; }
  .views { display: flex; }
  .views button { font: 700 0.95rem var(--font); display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border: 2px solid var(--ink); background: #fff; color: var(--ink); cursor: pointer; }
  .views button + button { border-left: 0; }
  .views button[aria-pressed='true'] { background: var(--ink); color: #fff; }
  .mapview { max-width: 640px; margin: 0 auto 24px; }
  #results :global(.school) { font-size: 1.25rem; }
  .empty { text-align: center; max-width: 640px; margin: 24px auto; padding: 48px 28px; border: 2px dashed var(--line-strong); }
  .empty h2 { font-size: 1.5rem; }
  .abbr { color: var(--muted); }
</style>
