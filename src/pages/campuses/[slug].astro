---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CenterLogo from '../../components/CenterLogo.astro';
import Icon from '../../components/Icon.astro';
import FloridaMap from '../../components/FloridaMap.astro';
import SocialIcon from '../../components/SocialIcon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { centers, withThe, distanceText, stateAbbr, KOSHER_KEYS, type Center } from '../../lib/centers';
import { SITE } from '../../lib/site';

export function getStaticPaths() {
  return centers.map((c) => ({ params: { slug: c.slug }, props: { center: c } }));
}
interface Props { center: Center }
const { center: c } = Astro.props;

const P = c.primaryCampus;
const pName = P.name;
const pThe = withThe(pName);
const abbr = P.abbr;
const short = abbr || pName;
const others = c.otherCampuses;
const sameSchool: Center[] = centers.filter((x) => x.id !== c.id && (x.primaryCampus.name.startsWith(pName.split(' (')[0]) || pName.startsWith(x.primaryCampus.name.split(' (')[0])));
const dist = distanceText(P.distance);
const cityState = `${c.city}, ${stateAbbr(c.address?.state ?? null)}`;
const addressLine = c.address ? [c.address.street, c.address.city, [stateAbbr(c.address.state), c.address.zip].filter(Boolean).join(' ')].filter(Boolean).join(', ') : null;
const mapsUrl = addressLine ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${c.officialName}, ${addressLine}`)}` : null;
const telHref = c.phone ? `tel:+1${c.phone.replace(/\D/g, '').replace(/^1/, '')}` : null;

const byChabad = c.amenities.filter((a) => a.byChabad);
const onCampusOnly = c.amenities.filter((a) => !a.byChabad && a.onCampus);
const kosher = c.amenities.filter((a) => KOSHER_KEYS.includes(a.key));
const hasServices = c.amenities.some((a) => a.key === 'Shabbat and holidays minyan');
const confirmedPrograms = c.programs.filter((p) => p.confirmed);
const networkPrograms = c.programs.filter((p) => !p.confirmed);
const socialLabel: Record<string, string> = { Facebook: 'Facebook', Instagram: 'Instagram', Twitter: 'X', TikTok: 'TikTok', YouTube: 'YouTube', LinkedIn: 'LinkedIn' };
const AMENITY_ICON: Record<string, string> = {
  'Jewish student lounge': 'Sofa',
  'Jewish student housing': 'BedDouble',
  'Full Kosher meal plan (3 meals a day)': 'UtensilsCrossed',
  'Daily Kosher meal plan (1 meal a day)': 'UtensilsCrossed',
  'Limited Kosher meal plan (1 or 2 meals a week)': 'UtensilsCrossed',
  'Kosher restaurant': 'ChefHat',
  'Packaged kosher food': 'Package',
  'Kosher food truck': 'Truck',
  'Kosher for Passover meal plan': 'Wine',
  'Shabbat and holidays minyan': 'Flame',
  'Daily minyan': 'Sunrise',
};
const PROGRAM_ICON: Record<string, string> = { jewishu: 'GraduationCap', 'sinai-scholars': 'BookOpen', 'birthright-israel': 'Plane', pegisha: 'Flame', 'your-israel': 'Globe', 'living-links': 'Landmark', 'florida-pegisha': 'Sun', 'soup-delivery': 'Soup', 'mezuzah-loans': 'DoorOpen' };
const always = [
  { icon: 'Flame', label: 'Shabbat dinners' },
  { icon: 'PartyPopper', label: 'Holiday celebrations' },
  { icon: 'BookOpen', label: 'Classes & learning' },
  { icon: 'MessageCircleHeart', label: 'Someone to talk to' },
];
const amenities = c.amenities.map((a) => ({ ...a, icon: AMENITY_ICON[a.key] || 'Check' }));
const heroBg = c.image?.src || null;
const quick = [
  telHref && { icon: 'Phone', label: 'Call', href: telHref },
  c.email && { icon: 'Mail', label: 'Email', href: `mailto:${c.email}` },
  mapsUrl && { icon: 'Navigation', label: 'Directions', href: mapsUrl, ext: true },
  c.website && { icon: 'Globe', label: 'Website', href: c.website, ext: true },
].filter(Boolean) as { icon: string; label: string; href: string; ext?: boolean }[];

const campusList = (list: typeof c.campuses) => {
  const names = list.map((x) => withThe(x.name));
  return names.length <= 1 ? names.join('') : `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}`;
};

// ---- SEO ----
const title = c.seoTitle ? c.seoTitle : abbr ? `Chabad at ${abbr} | Jewish Life at ${pThe}` : `Chabad at ${pThe} | Jewish Student Life & Shabbat`;
const descBits = [
  `Chabad at ${pThe}${abbr ? ` (${abbr})` : ''} in ${c.city}:`,
  'Shabbat dinners, Jewish holidays',
  kosher.length ? ', kosher food' : '',
  ' and classes for Jewish students.',
  c.directorsLine ? ` Meet ${c.directorsLine.split(',')[0]}.` : '',
];
let description = descBits.join('').replace(' ,', ',');
if (others.length && description.length < 130) description += ` Also serving ${others.map((o) => o.abbr || o.name).join(', ')}.`;
if (description.length > 165) description = description.slice(0, 162).replace(/\s+\S*$/, '') + '...';

const orgLd: any = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}${c.url}#center`,
  name: c.officialName,
  alternateName: [`Chabad at ${pName}`, ...(abbr ? [`${abbr} Chabad`, `Chabad at ${abbr}`] : [])],
  url: c.website || `${SITE.url}${c.url}`,
  description: `Chabad on Campus center serving Jewish students at ${campusList(c.campuses)}.`,
  ...(c.logo ? { logo: `${SITE.url}${c.logo.src}` } : {}),
  ...(c.image ? { image: `${SITE.url}${c.image.src}` } : {}),
  ...(c.phone ? { telephone: c.phone } : {}),
  ...(c.email ? { email: c.email } : {}),
  ...(c.address ? { address: { '@type': 'PostalAddress', streetAddress: c.address.street, addressLocality: c.address.city, addressRegion: 'FL', postalCode: c.address.zip, addressCountry: 'US' } } : {}),
  ...(c.location ? { location: { '@type': 'Place', name: c.officialName, geo: { '@type': 'GeoCoordinates', latitude: c.location.lat, longitude: c.location.lng }, ...(c.address ? { address: { '@type': 'PostalAddress', streetAddress: c.address.street, addressLocality: c.address.city, addressRegion: 'FL', postalCode: c.address.zip, addressCountry: 'US' } } : {}) } } : {}),
  areaServed: c.campuses.map((x) => ({ '@type': 'CollegeOrUniversity', name: x.name, ...(x.website ? { url: x.website } : {}) })),
  ...(c.staff.length ? { employee: c.staff.map((s) => ({ '@type': 'Person', name: s.name, ...(s.title ? { honorificPrefix: s.title } : {}), ...(s.role ? { jobTitle: s.role } : {}) })) } : {}),
  sameAs: [c.website, ...c.social.map((s) => s.url)].filter(Boolean),
  memberOf: { '@id': `${SITE.url}/#organization` },
};
const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  url: `${SITE.url}${c.url}`,
  about: { '@id': `${SITE.url}${c.url}#center` },
  isPartOf: { '@id': `${SITE.url}/#website` },
  ...(c.updatedAt ? { dateModified: c.updatedAt } : {}),
};
const crumbs = [
  { name: 'Find Your Campus', href: '/campuses/' },
  { name: `Chabad at ${short}`, href: c.url },
];

// ---- Q&A (unique per center, rendered as content, not FAQ schema) ----
const esc = (t: string) => t.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch]!);
const qa: { q: string; a: string; html?: boolean }[] = [];
qa.push({
  q: `Is there a Chabad at ${pThe}?`,
  a: `Yes. ${c.officialName} is the Chabad on Campus center for Jewish students at ${pThe}${others.length ? `, and it also serves ${campusList(others)}` : ''}.${c.directorsLine ? ` It is led by ${c.directorsLine}.` : ''}`,
});
if (addressLine) qa.push({ q: `Where is Chabad at ${short} located?`, a: `${c.officialName} is at ${addressLine}${dist ? `, ${dist}` : ''}.` });
qa.push({
  q: `Where can I go for Shabbat at ${short}?`,
  a: `${c.officialName} hosts Shabbat dinners for students${hasServices ? ' and runs Shabbat and holiday services' : ''}. Every Jewish student is welcome, whatever your background. Reach out to the Chabad House to find out this week's plans${c.website ? ' or check their website' : ''}.`,
});
if (kosher.length) {
  qa.push({
    q: `Is there kosher food at ${short}?`,
    a: `Yes. Kosher options for ${short} students include ${kosher.map((k) => k.label.charAt(0).toLowerCase() + k.label.slice(1)).join(', ')}. Ask ${c.officialName} for current details and schedules.`,
  });
} else {
  qa.push({ q: `Is there kosher food at ${short}?`, a: `Kosher options change from year to year. ${c.officialName} is the best place to ask about kosher meals, Shabbat food and Passover arrangements near ${pThe}.` });
}
if (c.directorsLine) {
  qa.push({
    q: `Who runs Chabad at ${short}?`,
    a: `${c.officialName} is independently operated by ${c.directorsLine}. As shluchim, emissaries of the Lubavitcher Rebbe, they have made ${pThe} their home and its Jewish students their family.`,
  });
}
qa.push({
  q: `Who funds Chabad at ${short}?`,
  html: true,
  a: `${esc(c.officialName)} is independently funded, powered by the generosity of parents, alumni and friends who believe in Jewish life at ${esc(pThe)}. It does not receive major funding from any international organization, which means every Shabbat dinner, holiday celebration and class here is made possible by people who care.${c.donateUrl ? ` <a href="${esc(c.donateUrl)}" rel="noopener">Support ${esc(c.officialName)}</a>.` : ''}`,
});
if (others.length) qa.push({ q: `Which other schools does ${c.officialName} serve?`, a: `Besides ${pThe}, ${c.officialName} welcomes students from ${campusList(others)}.` });
qa.push({
  q: `How do I get involved with Chabad at ${short}?`,
  a: `Just show up to a Shabbat dinner or event, or introduce yourself${c.email ? ` by emailing ${c.email}` : ''}${c.phone ? `${c.email ? ' or' : ''} calling ${c.phone}` : ''}. There is no membership, and you do not need to be observant.`,
});
---
<Base title={title} description={description} path={c.url} jsonLd={[orgLd, pageLd]} breadcrumbs={crumbs} ogImage={c.image?.src || undefined}>
  <section class="chero">
    {heroBg ? (
      <div class="bg"><img src={heroBg} srcset={c.image!.srcset} sizes="100vw" width={c.image!.width} height={c.image!.height} alt="" fetchpriority="high" decoding="async" /></div>
    ) : (
      <img class="bgmark" src="/flame.png" alt="" width="96" height="96" />
    )}
    <div class="wrap hero-in">
      <Breadcrumbs items={crumbs} />
      <div class="id">
        <CenterLogo center={c} size={96} eager />
        <div>
          <p class="official">{c.officialName}</p>
          <p class="loc"><Icon name="MapPin" size={18} /> {cityState}</p>
        </div>
      </div>
      <h1>Chabad at {pThe}</h1>
      {c.directorsLine && <p class="lead">Led by {c.directorsLine}</p>}
    </div>
  </section>

  <nav class="quickbar" aria-label="Contact shortcuts">
    <div class="wrap qb-in">
      {quick.map((q) => (
        <a href={q.href} rel={q.ext ? 'noopener' : undefined}><Icon name={q.icon} size={22} /><span>{q.label}</span></a>
      ))}
      {c.donateUrl && <a href={c.donateUrl} rel="noopener" class="give"><Icon name="HeartHandshake" size={22} /><span>Support</span></a>}
    </div>
  </nav>

  <div class="wrap dash">
    <div class="main">
      <section class="panel intro reveal">
        <h2>Welcome to Chabad at {short}</h2>
        <p class="lead">
          {c.officialName} is the Jewish home away from home for students at {pThe}{others.length ? <> and {campusList(others)}</> : ''}.
          {c.address && dist ? <> You'll find it at {c.address.street}, {dist}.</> : ''}
        </p>
        <p>Come for Friday night Shabbat dinner, celebrate the holidays, take a class, or just stop by between classes. Every Jewish student is welcome, whatever your background, and there is no membership.</p>
        <div class="tiles">
          {always.map((t) => <div class="tile"><span class="bubble sm gold"><Icon name={t.icon} size={20} /></span><span>{t.label}</span></div>)}
        </div>
        {sameSchool.length > 0 && (
          <p class="callout blue"><Icon name="Info" size={22} /> <span>{pThe.replace(/^the/, 'The')} has more than one Chabad on Campus center. Also see {sameSchool.map((s, i) => <>{i > 0 && ', '}<a href={s.url}>{s.officialName}</a></>)}.</span></p>
        )}
      </section>

      {c.staff.length > 0 && (
        <section class="panel reveal">
          <div class="ph"><span class="bubble blue"><Icon name="Users" size={24} /></span><h2>Your rabbi and rebbetzin</h2></div>
          <p class="muted">Chabad Houses are led by <em>shluchim</em>, emissaries of the Lubavitcher Rebbe who make their home your home.</p>
          <ul class="staff">
            {c.staff.map((s) => (
              <li>
                {s.photo ? <img src={s.photo.src} width={120} height={120} alt={`${s.title && /rabbi/i.test(s.title) ? 'Rabbi ' : ''}${s.name}`} loading="lazy" decoding="async" /> : <span class="nophoto" aria-hidden="true"></span>}
                <strong>{s.title && /rabbi/i.test(s.title) ? 'Rabbi ' : ''}{s.name}</strong>
                {s.role && <span>{s.role}</span>}
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="panel reveal">
        <div class="ph"><span class="bubble gold"><Icon name="Sparkles" size={24} /></span><h2>At a glance</h2></div>
        {amenities.length > 0 ? (
          <ul class="amen">
            {amenities.map((a) => (
              <li>
                <span class="bubble sm"><Icon name={a.icon} size={20} /></span>
                <span class="al">{a.label}<small>{a.byChabad && a.onCampus ? 'Chabad & campus' : a.byChabad ? 'At Chabad' : 'On or near campus'}</small></span>
              </li>
            ))}
          </ul>
        ) : (
          <p>Ask {c.officialName} about this semester's schedule, kosher food and upcoming events.</p>
        )}
        <p class="more">
          <a href="/jewish-life-on-campus/shabbat/">Shabbat on campus</a>
          <a href="/jewish-life-on-campus/jewish-holidays/">Jewish holidays</a>
          <a href="/jewish-life-on-campus/kosher-food/">Kosher food</a>
        </p>
      </section>

      <section class="panel reveal">
        <div class="ph"><span class="bubble blue"><Icon name="Rocket" size={24} /></span><h2>Programs</h2></div>
        <ul class="progs">
          {c.programs.map(({ program: p }) => (
            <li>
              <a href={`/programs/${p.slug}/`}>
                <span class="bubble sm gold"><Icon name={PROGRAM_ICON[p.slug] || 'Star'} size={20} /></span>
                <span class="pl"><strong>{p.name}</strong><small>{p.tagline}</small></span>
                <Icon name="ArrowRight" size={20} />
              </a>
            </li>
          ))}
        </ul>
        {c.jewishU && <p class="small"><a href={c.jewishU.locationUrl} rel="noopener">See current JewishU courses at {c.officialName}</a></p>}
      </section>

      <section class="panel reveal">
        <div class="ph"><span class="bubble gold"><Icon name="GraduationCap" size={24} /></span><h2>{c.campuses.length > 1 ? 'Campuses served' : 'Campus served'}</h2></div>
        <div class="campuses">
          {c.campuses.map((x, i) => {
            const dt = distanceText(x.distance, x.primary ? 'campus' : x.abbr || 'campus');
            const inf = x.info;
            const rows = inf ? [
              inf.publicInstitution !== null && { icon: 'Landmark', k: 'Type', v: inf.publicInstitution ? 'Public' : 'Private' },
              inf.levels.length > 0 && { icon: 'GraduationCap', k: 'Degrees', v: inf.levels.map((l) => (l === 'Grad' ? 'Graduate' : 'Undergraduate')).sort().reverse().join(' & ') },
              inf.undergrad && { icon: 'Users', k: 'Undergraduates', v: inf.undergrad.toLocaleString('en-US') },
              inf.grad && { icon: 'Users', k: 'Graduate students', v: inf.grad.toLocaleString('en-US') },
              inf.jewishUndergrad && { icon: 'Star', k: 'Jewish undergraduates', v: `About ${inf.jewishUndergrad.toLocaleString('en-US')}` },
              inf.jewishGrad && { icon: 'Star', k: 'Jewish graduate students', v: `About ${inf.jewishGrad.toLocaleString('en-US')}` },
              dt && { icon: 'Navigation', k: 'Chabad House', v: dt.charAt(0).toUpperCase() + dt.slice(1) },
            ].filter(Boolean) as { icon: string; k: string; v: string }[] : [];
            return (
              <details id={x.anchor} class="cinfo" open={i === 0 && c.campuses.length === 1}>
                <summary>
                  <span class="cn">{x.name}{x.abbr && <em>{x.abbr}</em>}</span>
                  <span class="cd">{x.primary ? 'Main campus' : 'Also welcome'}</span>
                  <Icon name="ChevronDown" size={22} class="chev" />
                </summary>
                <div class="cbody">
                  <h3 class="ctitle">Campus information</h3>
                  {rows.length > 0 ? (
                    <dl class="cgrid">
                      {rows.map((r) => <div><dt><Icon name={r.icon} size={18} /> {r.k}</dt><dd>{r.v}</dd></div>)}
                    </dl>
                  ) : (
                    <p class="muted">Ask {c.officialName} about Jewish life at {withThe(x.name)}.</p>
                  )}
                  {inf && inf.studentLife.length > 0 && (
                    <p class="slife"><strong>Jewish life on campus:</strong> {inf.studentLife.join(', ')}</p>
                  )}
                  {x.website && <a class="textlink" href={x.website} rel="noopener">{x.name} website <Icon name="ArrowUpRight" size={18} /></a>}
                </div>
              </details>
            );
          })}
        </div>
      </section>

      <section class="panel reveal">
        <div class="ph"><span class="bubble blue"><Icon name="MessageCircleQuestion" size={24} /></span><h2>Questions about Chabad at {short}</h2></div>
        <div class="faq">
          {qa.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <div class="answer">{item.html ? <p set:html={item.a} /> : <p>{item.a}</p>}</div>
            </details>
          ))}
        </div>
      </section>
    </div>

    <aside class="side" aria-label="Contact information">
      <div class="contact">
        <h2>Get in touch</h2>
        <ul class="cl">
          {addressLine && <li><Icon name="MapPin" size={20} /><span>{addressLine}{mapsUrl && <><br /><a href={mapsUrl} rel="noopener">Get directions</a></>}</span></li>}
          {c.phone && <li><Icon name="Phone" size={20} /><a href={telHref}>{c.phone}</a></li>}
          {c.email && <li><Icon name="Mail" size={20} /><a href={`mailto:${c.email}`}>{c.email}</a></li>}
          {c.website && <li><Icon name="Globe" size={20} /><a href={c.website} rel="noopener">{c.website.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a></li>}
          {!addressLine && <li><Icon name="MapPin" size={20} /><span>{cityState}</span></li>}
        </ul>
        {c.social.length > 0 && (
          <div class="social">
            {c.social.map((s) => <a href={s.url} rel="noopener" aria-label={`${c.officialName} on ${socialLabel[s.type] || s.type}`}><SocialIcon type={s.type} size={20} /></a>)}
          </div>
        )}
        {c.website && <a class="btn btn-gold full" href={c.website} rel="noopener">Visit their website <Icon name="ArrowUpRight" size={20} /></a>}
        {c.donateUrl && <a class="btn btn-white full" href={c.donateUrl} rel="noopener"><Icon name="Heart" size={20} /> Support {c.officialName}</a>}
      </div>
      {c.location && <div class="minimap"><FloridaMap highlight={c.id} compact /></div>}
    </aside>
  </div>


  <CtaBand
    title={`Heading to ${short}?`}
    text={`Say hello to ${c.officialName} before you arrive, and your first Shabbat dinner is already planned.`}
    primary={c.website ? { href: c.website, label: `Connect with Chabad at ${short}` } : { href: '/campuses/', label: 'Find your campus' }}
    secondary={{ href: '/parents/', label: 'For parents' }}
  />
</Base>

<script>
  const openHash = () => {
    const el = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
    if (el instanceof HTMLDetailsElement) el.open = true;
  };
  openHash();
  addEventListener('hashchange', openHash);
</script>

<style>
  .chero { position: relative; overflow: hidden; background: var(--blue-night); color: #fff; padding: clamp(40px, 6vw, 72px) 0 clamp(64px, 9vw, 120px); }
  .chero .bg { position: absolute; inset: 0; }
  .chero .bg img { width: 100%; height: 100%; object-fit: cover; opacity: 0.35; filter: saturate(0.9); }
  .chero .bg::after { content: ''; position: absolute; inset: 0; background: rgba(12, 47, 71, 0.55); }
  .bgmark { position: absolute; right: -40px; bottom: -80px; width: 460px; height: auto; opacity: 0.12; }
  .hero-in { position: relative; }
  .chero :global(.crumbs) { color: #cfe2f0; }
  .id { display: flex; align-items: center; gap: 22px; margin-bottom: clamp(28px, 4vw, 44px); }
  .id :global(.clogo) { border: 4px solid #fff; }
  .official { margin: 0; font-weight: 750; font-size: 1.2rem; }
  .loc { margin: 4px 0 0; display: flex; align-items: center; gap: 6px; color: #cfe2f0; }
  .loc :global(.icon) { color: var(--gold); }
  .chero h1 { color: #fff; max-width: 16ch; margin-bottom: 20px; }
  .chero .lead { color: #e3eff8; margin: 0; max-width: 50ch; }

  .quickbar { background: var(--gold); position: sticky; top: 75px; z-index: 20; }
  .qb-in { display: flex; }
  .quickbar a { flex: 1; display: flex; align-items: center; justify-content: center; gap: 10px; padding: 18px 12px; color: var(--ink); text-decoration: none; font-weight: 750; transition: background 0.2s, color 0.2s; }
  .quickbar a + a { border-left: 1px solid rgba(0, 0, 0, 0.15); }
  .quickbar a:hover { background: var(--ink); color: var(--gold); }
  @media (max-width: 560px) { .quickbar a { flex-direction: column; gap: 4px; font-size: 0.8rem; padding: 12px 4px; } }

  .dash { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: clamp(40px, 5vw, 72px); align-items: start; padding-top: clamp(48px, 7vw, 88px); padding-bottom: clamp(64px, 9vw, 112px); }
  @media (max-width: 1000px) { .dash { grid-template-columns: minmax(0, 1fr); } }
  .main { display: grid; gap: clamp(48px, 6vw, 72px); }
  .panel h2 { font-size: clamp(1.6rem, 2.6vw, 2.1rem); margin: 0; }
  .intro h2 { margin-bottom: 18px; }
  .ph { display: flex; align-items: center; gap: 16px; margin-bottom: 24px; }
  .panel > p { max-width: 64ch; }

  .tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 28px; }
  @media (max-width: 720px) { .tiles { grid-template-columns: 1fr 1fr; } }
  .tile { background: var(--gold-wash); padding: 18px; display: flex; flex-direction: column; gap: 14px; font-weight: 750; line-height: 1.3; }
  .callout { margin-top: 24px; align-items: center; }

  .staff { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 28px 20px; }
  .staff li { display: flex; flex-direction: column; gap: 4px; }
