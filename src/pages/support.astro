---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SchoolSearch from '../components/SchoolSearch.astro';
import CenterLogo from '../components/CenterLogo.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { centers } from '../lib/centers';
import { SITE, img } from '../lib/site';

const path = '/support/';
const crumbs = [{ name: 'Support', href: path }];
const hero = img('shabbat-candles');
const gives = [
  { icon: 'UtensilsCrossed', title: 'Shabbat dinners', text: 'A warm, home-cooked meal every Friday night for any student who walks in.' },
  { icon: 'PartyPopper', title: 'Every holiday', text: 'High Holiday services, a sukkah by campus, Chanukah, Purim and Passover Seders.' },
  { icon: 'HeartHandshake', title: 'Someone to call', text: 'A rabbi and rebbetzin who are there for students on the good days and the hard ones.' },
];
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Support Chabad on Campus in Florida',
    url: `${SITE.url}${path}`,
    description: 'Support the Chabad on Campus center at your school or your child’s school in Florida.',
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
];
---
<Base
  title="Support Chabad on Campus in Florida"
  description="Support the Chabad on Campus center at your school, or the one your child calls home. Find any Florida Chabad House and give directly to it."
  path={path}
  breadcrumbs={crumbs}
  jsonLd={ld}
>
  <section class="shero">
    <div class="stext band-blue">
      <div class="sin">
        <Breadcrumbs items={crumbs} />
        <h1>Support your local Chabad on Campus</h1>
        <p class="lead">Give to the Chabad House closest to your heart: your own campus, or the one your child calls home.</p>
      </div>
    </div>
    <div class="smedia"><img src={hero.src} srcset={hero.srcset} sizes="(max-width: 960px) 100vw, 55vw" width={hero.width} height={hero.height} alt="Students lighting Shabbat candles together at a Chabad House" fetchpriority="high" /></div>
  </section>

  <section class="pick band-gold">
    <div class="wrap pk">
      <div>
        <h2>Choose a Chabad House</h2>
        <p>Search for a school or pick from the list. Your gift goes straight to that center.</p>
      </div>
      <SchoolSearch id="give" size="lg" mode="donate" label="Choose a Chabad House" showLabel={false} placeholder="Search" />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2>Where your support goes</h2>
        <p class="lead">Every Chabad House in Florida is independently run and supported by people like you.</p>
      </div>
      <div class="gives">
        {gives.map((g, i) => (
          <div class="reveal" style={`--d:${i * 100}ms`}>
            <span class="bubble lg gold"><Icon name={g.icon} size={30} /></span>
            <h3>{g.title}</h3>
            <p>{g.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section band-cream">
    <div class="wrap">
      <h2 class="lh">Every Florida Chabad House</h2>
      <ul class="dlist">
        {centers.map((c) => (
          <li>
            <a class="who" href={c.url}>
              <CenterLogo center={c} size={52} />
              <span><strong>{c.primaryCampus.name}</strong><small>{c.officialName} · {c.city}</small></span>
            </a>
            {c.donateUrl
              ? <a class="btn btn-blue give" href={c.donateUrl} rel="noopener" target="_blank"><Icon name="Heart" size={18} /> Donate</a>
              : <a class="btn btn-ghost give" href={c.url}>Contact</a>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand title="Know a student heading to a Florida college?" text="Help them find their Chabad House before the semester starts." />
</Base>

<style>
  .shero { display: grid; grid-template-columns: minmax(0, 48fr) minmax(0, 52fr); min-height: clamp(440px, 60vh, 600px); }
  @media (max-width: 960px) { .shero { grid-template-columns: minmax(0, 1fr); } }
  .stext { display: flex; align-items: center; padding: clamp(48px, 7vw, 96px) var(--gutter); }
  .sin { max-width: 560px; margin-left: auto; width: 100%; }
  @media (max-width: 960px) { .sin { margin: 0; } }
  .stext h1 { margin-bottom: 22px; }
  .stext .lead { margin: 0; max-width: 36ch; }
  .smedia { position: relative; min-height: 300px; background: var(--blue-night); }
  .smedia img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  .pick { padding: clamp(56px, 7vw, 96px) 0; }
  .pk { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 32px clamp(40px, 6vw, 96px); align-items: center; }
  @media (max-width: 900px) { .pk { grid-template-columns: minmax(0, 1fr); } }
  .pk h2 { margin-bottom: 10px; }
  .pk p { margin: 0; color: var(--ink); font-size: 1.1rem; }
  .pk :global(.ss) { max-width: none; }

  .gives { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(32px, 5vw, 72px); }
  @media (max-width: 860px) { .gives { grid-template-columns: minmax(0, 1fr); } }
  .gives h3 { font-size: 1.35rem; margin: 22px 0 8px; }
  .gives p { margin: 0; color: var(--ink-2); }

  .lh { margin-bottom: 32px; }
  .dlist { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 2px solid var(--ink); }
  @media (max-width: 860px) { .dlist { grid-template-columns: minmax(0, 1fr); } }
  .dlist li { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 0; border-bottom: 1px solid var(--line-strong); }
  @media (min-width: 861px) { .dlist li:nth-child(odd) { padding-right: 32px; } .dlist li:nth-child(even) { padding-left: 32px; border-left: 1px solid var(--line-strong); } }
  .who { display: flex; align-items: center; gap: 14px; min-width: 0; text-decoration: none; color: var(--ink); }
  .who strong { display: block; line-height: 1.25; }
  .who small { display: block; color: var(--muted); font-size: 0.88rem; line-height: 1.4; }
  .who:hover strong { color: var(--blue); }
  .give { flex-shrink: 0; padding: 11px 16px; font-size: 0.93rem; }
</style>
